<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_transfer_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.transfer.wizard.form</field>
        <field name="model">whatsapp.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="phone_number" placeholder="255786XXXXXX"/>
                    <field name="message"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send Message" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
