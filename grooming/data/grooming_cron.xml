<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- CRON for Grooming Reminders -->
        <record id="ir_cron_grooming_reminder" model="ir.cron">
            <field name="name">Grooming: Send Appointment Reminders (24h Before)</field>
            <field name="model_id" ref="model_grooming_appointment"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
