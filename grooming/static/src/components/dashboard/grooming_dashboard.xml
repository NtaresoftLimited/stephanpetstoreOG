<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="grooming.GroomingDashboard" owl="1">
        <div class="o_grooming_dashboard h-100 overflow-auto p-4">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="dashboard-header-title">Stephans Grooming Dashboard</h3>
            </div>

            <!-- Quick Actions -->
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <h5 class="fw-bold text-dark mb-3 ps-1">Quick Actions</h5>
                </div>
                <div class="col-md-3">
                    <div t-on-click="openQuickAppointment" class="dashboard-card p-3 cursor-pointer text-center">
                        <i class="fa fa-plus-circle fa-2x text-primary mb-2"/>
                        <div class="fw-bold">New Booking</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div t-on-click="() => this.openAppointments('pending')" class="dashboard-card p-3 cursor-pointer text-center">
                        <i class="fa fa-clock-o fa-2x text-warning mb-2"/>
                        <div class="fw-bold">Pending Requests</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div t-on-click="openQuickExpense" class="dashboard-card p-3 cursor-pointer text-center">
                        <i class="fa fa-file-text-o fa-2x text-danger mb-2"/>
                        <div class="fw-bold">Record Expense</div>
                    </div>
                </div>
            </div>

            <!-- Stats Row -->
            <div class="row g-4 mb-4">
                <!-- Total Appointments -->
                <div class="col-md-3">
                    <div class="dashboard-card p-4 d-flex align-items-center">
                        <div class="stat-card-icon icon-blue-light me-3">
                            <i class="fa fa-calendar"/>
                        </div>
                        <div>
                            <div class="stat-value"><t t-out="state.stats.total_appointments"/></div>
                            <div class="stat-label">Total Bookings</div>
                        </div>
                    </div>
                </div>

                <!-- Confirmed -->
                <div class="col-md-3">
                    <div class="dashboard-card p-4 d-flex align-items-center">
                        <div class="stat-card-icon icon-cyan-light me-3">
                            <i class="fa fa-check-circle"/>
                        </div>
                        <div>
                            <div class="stat-value"><t t-out="state.stats.confirmed"/></div>
                            <div class="stat-label">Confirmed</div>
                        </div>
                    </div>
                </div>

                <!-- In Progress -->
                <div class="col-md-3">
                    <div class="dashboard-card p-4 d-flex align-items-center">
                        <div class="stat-card-icon icon-purple-light me-3">
                            <i class="fa fa-bath"/>
                        </div>
                        <div>
                            <div class="stat-value"><t t-out="state.stats.in_progress"/></div>
                            <div class="stat-label">In Grooming</div>
                        </div>
                    </div>
                </div>

                <!-- Revenue -->
                <div class="col-md-3">
                    <div class="dashboard-card p-4 d-flex align-items-center">
                        <div class="stat-card-icon icon-orange-light me-3">
                            <i class="fa fa-money"/>
                        </div>
                        <div>
                            <!-- Simple internal formatting or call JS helper -->
                            <div class="stat-value" style="font-size: 1.5rem;"><t t-out="formatCurrency(state.stats.total_revenue_month)"/></div>
                            <div class="stat-label">Revenue (Month)</div>
                        </div>
                    </div>
                </div>
                
                <!-- Expenses -->
                <div class="col-md-3">
                    <div class="dashboard-card p-4 d-flex align-items-center">
                        <div class="stat-card-icon icon-cyan-light me-3" style="background-color: #fee2e2; color: #ef4444;">
                            <i class="fa fa-credit-card"/>
                        </div>
                        <div>
                            <div class="stat-value" style="font-size: 1.5rem;"><t t-out="formatCurrency(state.stats.total_expenses_month)"/></div>
                            <div class="stat-label">Expenses (Month)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Appointments & Charts -->
            <div class="row g-4">
                <!-- Recent List -->
                <div class="col-md-8">
                    <div class="dashboard-card h-100">
                        <div class="card-header-clean d-flex justify-content-between">
                            <span>Recent Appointments</span>
                            <small class="text-primary cursor-pointer" t-on-click="() => this.openAppointments()">View All</small>
                        </div>
                        <div class="p-0 table-responsive">
                            <table class="table table-clean mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Pet</th>
                                        <th>Customer</th>
                                        <th>Status</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.stats.recent_appointments" t-as="appt" t-key="appt.id">
                                        <td><t t-out="appt.appointment_date"/></td>
                                        <td class="fw-bold"><t t-out="appt.pet_name"/></td>
                                        <td><t t-out="appt.partner_id[1]"/></td>
                                        <td>
                                            <span t-attf-class="badge-clean {{ appt.state === 'completed' ? 'badge-success-soft' : appt.state === 'pending' ? 'badge-warning-soft' : appt.state === 'cancelled' ? 'badge-gray-soft' : 'badge-info-soft' }}">
                                                <t t-out="appt.state"/>
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold"><t t-out="formatCurrency(appt.total_price)"/></td>
                                    </tr>
                                    <tr t-if="!state.stats.recent_appointments || !state.stats.recent_appointments.length">
                                        <td colspan="5" class="text-center text-muted py-3">No recent appointments</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Donut Chart / Overview -->
                <div class="col-md-4">
                    <div class="dashboard-card h-100 p-4">
                        <h5 class="fw-bold text-dark mb-4">Status Overview</h5>
                        <div class="donut-chart-container mb-4">
                            <!-- Helper for gradient: Pending(Yellow), Confirmed(Blue), Grooming(Purple), Completed(Green) -->
                            <!-- This is a simplification; for real dynamic charts, we'd calculate percentages in JS. 
                                 Here just a visual placeholder style or simple JS could set the style. -->
                            <div class="donut-chart" style="background: conic-gradient(#eab308 0% 25%, #06b6d4 25% 50%, #9333ea 50% 75%, #10b981 75% 100%);">
                                <div class="donut-hole">
                                    <div class="donut-value"><t t-out="state.stats.total_appointments"/></div>
                                    <div class="donut-label">Total</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex flex-column gap-2">
                           <div class="chart-legend-item">
                                <span class="legend-dot" style="background-color: #eab308;"></span>
                                <span>Pending (<t t-out="state.stats.pending"/>)</span>
                            </div>
                            <div class="chart-legend-item">
                                <span class="legend-dot" style="background-color: #06b6d4;"></span>
                                <span>Confirmed (<t t-out="state.stats.confirmed"/>)</span>
                            </div>
                            <div class="chart-legend-item">
                                <span class="legend-dot" style="background-color: #9333ea;"></span>
                                <span>In Grooming (<t t-out="state.stats.in_progress"/>)</span>
                            </div>
                            <div class="chart-legend-item">
                                <span class="legend-dot" style="background-color: #10b981;"></span>
                                <span>Completed (<t t-out="state.stats.completed"/>)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
