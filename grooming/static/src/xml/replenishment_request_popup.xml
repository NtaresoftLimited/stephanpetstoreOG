<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="grooming.ReplenishmentRequestPopup">
        <Dialog title="props.title">
            <div class="form-group p-3">
                
                <!-- Product Search -->
                <div class="mb-3 text-start position-relative">
                    <label class="form-label text-start w-100 fw-bold">Add Product to Replenishment</label>
                    <input type="text" class="form-control" placeholder="Search product by name or barcode..." t-model="state.searchQuery" t-on-input="onSearchInput" />
                    
                    <t t-if="state.searchResults.length > 0">
                        <div class="list-group position-absolute w-100 shadow mt-1" style="z-index: 1050; max-height: 240px; overflow-y: auto;">
                            <t t-foreach="state.searchResults" t-as="product" t-key="product.id">
                                <t t-set="p_avail" t-value="state.stockAvailability[product.id]" />
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center text-start py-2" t-on-click="() => this.addProduct(product)">
                                    <span class="text-truncate me-2 fw-medium" t-esc="product.display_name" />
                                    <span t-if="p_avail !== undefined and p_avail &gt; 0" class="badge rounded-pill bg-success text-white px-2 py-1 shrink-0" style="font-size: 0.75rem;">
                                        <i class="fa fa-cubes me-1"/>Available: <t t-esc="p_avail"/>
                                    </span>
                                    <span t-elif="p_avail !== undefined and p_avail &lt;= 0" class="badge rounded-pill bg-danger text-white px-2 py-1 shrink-0" style="font-size: 0.75rem;">
                                        <i class="fa fa-times me-1"/>Out of stock
                                    </span>
                                    <span t-else="" class="badge rounded-pill bg-secondary text-white px-2 py-1 shrink-0" style="font-size: 0.75rem;">
                                        <i class="fa fa-circle-o-notch fa-spin me-1"/>...
                                    </span>
                                </button>
                            </t>
                        </div>
                    </t>
                </div>

                <div class="mb-3 text-start mt-4">
                    <label class="form-label text-start w-100 fw-bold">Products to Replenish</label>
                    <table class="table table-sm table-hover align-middle mt-2">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-center" style="width: 140px;">Available</th>
                                <th class="text-center" style="width: 140px;">Qty to Request</th>
                                <th style="width: 45px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.cartLines.length === 0">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <i class="fa fa-shopping-basket fa-2x mb-2 d-block text-muted opacity-50"/>
                                        No products selected. Search above to add items!
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="state.cartLines" t-as="line" t-key="line.product_id">
                                <t t-set="avail" t-value="state.stockAvailability[line.product_id]" />
                                <t t-set="exceeded" t-value="isQtyExceeded(line)" />
                                <tr>
                                    <td>
                                        <div class="fw-semibold" t-esc="line.product_name" />
                                        <div t-if="exceeded" class="text-danger small mt-1 fw-bold">
                                            <i class="fa fa-exclamation-triangle me-1"/>Exceeds stock (<t t-esc="avail || 0"/> available)
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div t-if="avail !== undefined and avail &gt; 0" class="d-flex align-items-center justify-content-center gap-1">
                                            <span class="badge bg-success text-white px-2 py-1" style="font-size: 0.8rem;">
                                                <t t-esc="avail"/> units
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem; line-height: 1.5;" title="Fill maximum available quantity" t-on-click="() => this.setMaxQty(line)">
                                                Max
                                            </button>
                                        </div>
                                        <div t-elif="avail !== undefined and avail &lt;= 0">
                                            <span class="badge bg-danger text-white px-2 py-1" style="font-size: 0.8rem;">
                                                0 units
                                            </span>
                                        </div>
                                        <div t-else="" class="text-muted small">
                                            <i class="fa fa-circle-o-notch fa-spin me-1"/>Checking...
                                        </div>
                                    </td>
                                    <td>
                                        <input type="number" 
                                               t-attf-class="form-control form-control-sm text-center {{ exceeded ? 'border-danger text-danger bg-danger-subtle fw-bold' : '' }}" 
                                               t-att-value="line.qty" 
                                               t-on-change="(e) => this.updateQty(line, e.target.value)" 
                                               min="1" />
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-link text-danger p-0" title="Remove" t-on-click="() => this.removeLine(line)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm">
                    Submit Replenishment
                </button>
                <button class="btn btn-secondary" t-on-click="cancel">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>
</templates>
