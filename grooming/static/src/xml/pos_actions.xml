<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 20 port of the POS action buttons.
         Odoo 20 rebuilt ControlButtons: the Odoo 18 xpaths (OrderlineNoteButton, showRemainingButtons/div,
         pos_sale/pos_loyalty/pos_discount buttons) no longer match, and an unmatched xpath stops the POS
         from rendering. Only elements of point_of_sale's own template are targeted here. -->
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">

        <!-- Hidden like production: the order "Note" (main bar and small-screen dialog) and "Customer Note" -->
        <xpath expr="//t[@t-if='!this.props.showRemainingButtons']/InternalNoteButton" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//t[@t-if='(this.pos.isSmallProductScreen and this.props.showRemainingButtons)']/InternalNoteButton" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//NoteButton" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>

        <!-- Stock request buttons in the "Actions" (more) dialog -->
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <t t-call="point_of_sale.controlButton"
                icon="'local_shipping'"
                btnText.translate="Request Stock"
                btnClasses="'btn-secondary o_grooming_request_stock'"
                onClick="() => this.clickRequestStock()"/>
            <t t-call="point_of_sale.controlButton"
                icon="'shopping_cart'"
                btnText.translate="Replenishment Request"
                btnClasses="'btn-secondary o_grooming_replenishment'"
                onClick="() => this.clickReplenishmentRequest()"/>
        </xpath>

    </t>
</templates>
