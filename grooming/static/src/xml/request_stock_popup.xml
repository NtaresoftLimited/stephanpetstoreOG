<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="grooming.RequestStockPopup">
        <Dialog title="props.title">
            <div class="form-group p-3">
                
                <!-- TOP SECTION: Request From (Source) & Destination (Store) -->
                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-6 text-start">
                        <label class="form-label text-start w-100 fw-bold">Request From (Source Warehouse) <span class="text-danger">*</span></label>
                        <select class="form-select fw-semibold" t-model="state.sourceWarehouseId" t-on-change="onSourceWarehouseChange">
                            <option value="" disabled="1">Select Source Warehouse...</option>
                            <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                                <option t-att-value="wh.id" t-att-selected="wh.id === state.sourceWarehouseId">
                                    <t t-esc="wh.name" />
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 text-start">
                        <label class="form-label text-start w-100 fw-bold">Destination (To Store)</label>
                        <div class="form-control bg-light text-dark fw-bold">
                            <i class="fa fa-map-marker text-danger me-1"></i>
                            <t t-esc="state.destinationWarehouseName" />
                        </div>
                    </div>
                </div>

                <hr class="my-3 border-secondary opacity-25" />

                <!-- Add Products Section -->
                <div class="mb-3 text-start position-relative">
                    <label class="form-label text-start w-100 fw-bold">Add Products <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="Search by product name, SKU, or barcode..." 
                           t-model="state.searchQuery" t-on-input="onSearchProduct" />
                    
                    <!-- Search Results Dropdown with Available Badge -->
                    <div t-if="state.searchResults.length > 0" class="list-group position-absolute w-100 shadow mt-1" style="z-index: 1050; max-height: 240px; overflow-y: auto;">
                        <t t-foreach="state.searchResults" t-as="product" t-key="product.id">
                            <t t-set="p_avail" t-value="state.stockAvailability[product.id]" />
                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center text-start py-2" t-on-click="() => this.addProduct(product)">
                                <span class="text-truncate me-2 fw-medium" t-esc="product.display_name" />
                                <span t-if="p_avail !== undefined and p_avail &gt; 0" class="badge rounded-pill bg-success text-white px-2 py-1 shrink-0" style="font-size: 0.75rem;">
                                    <i class="fa fa-cubes me-1"/>Available: <t t-esc="p_avail"/>
                                </span>
                                <span t-elif="p_avail !== undefined and p_avail &lt;= 0" class="badge rounded-pill bg-danger text-white px-2 py-1 shrink-0" style="font-size: 0.75rem;">
                                    <i class="fa fa-times me-1"/>Out of stock
                                </span>
                                <span t-else="" class="badge rounded-pill bg-secondary text-white px-2 py-1 shrink-0" style="font-size: 0.75rem;">
                                    <i class="fa fa-circle-o-notch fa-spin me-1"/>...
                                </span>
                            </button>
                        </t>
                    </div>
                </div>

                <!-- Product Table with Available Column -->
                <div class="mb-3 text-start">
                    <label class="form-label text-start w-100 fw-bold">Products to Request</label>
                    <table class="table table-sm table-hover align-middle mt-2 border-bottom">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-center" style="width: 140px;">Available</th>
                                <th class="text-center" style="width: 150px;">Qty</th>
                                <th style="width: 45px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.cartLines.length === 0">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4 border-bottom">
                                        <i class="fa fa-truck fa-2x mb-2 d-block text-muted opacity-50"/>
                                        No products added yet. Search above to add items!
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="state.cartLines" t-as="line" t-key="line.product_id">
                                <t t-set="avail" t-value="state.stockAvailability[line.product_id]" />
                                <t t-set="exceeded" t-value="isQtyExceeded(line)" />
                                <tr>
                                    <td>
                                        <div class="fw-semibold" t-esc="line.product_name" />
                                        <div t-if="exceeded" class="text-danger small mt-1 fw-bold">
                                            <i class="fa fa-exclamation-triangle me-1"/>Exceeds stock (<t t-esc="avail || 0"/> available)
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div t-if="avail !== undefined and avail &gt; 0" class="d-flex align-items-center justify-content-center gap-1">
                                            <span class="badge bg-success text-white px-2 py-1" style="font-size: 0.8rem;">
                                                <t t-esc="avail"/> units
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem; line-height: 1.5;" title="Fill maximum available quantity" t-on-click="() => this.setMaxQty(line)">
                                                Max
                                            </button>
                                        </div>
                                        <div t-elif="avail !== undefined and avail &lt;= 0">
                                            <span class="badge bg-danger text-white px-2 py-1" style="font-size: 0.8rem;">
                                                0 units
                                            </span>
                                        </div>
                                        <div t-else="" class="text-muted small">
                                            <i class="fa fa-circle-o-notch fa-spin me-1"/>Checking...
                                        </div>
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="input-group input-group-sm justify-content-center mx-auto" style="width: 120px;">
                                            <button class="btn btn-outline-secondary" type="button" t-on-click="() => this.updateQty(line, -1)">-</button>
                                            <input type="text" 
                                                   t-attf-class="form-control text-center px-1 {{ exceeded ? 'border-danger text-danger bg-danger-subtle fw-bold' : '' }}" 
                                                   t-att-value="line.qty" 
                                                   t-on-change="(e) => this.onQtyChange(line, e)" />
                                            <button class="btn btn-outline-secondary" type="button" t-on-click="() => this.updateQty(line, 1)">+</button>
                                        </div>
                                    </td>
                                    <td class="text-center align-middle">
                                        <button class="btn btn-sm btn-link text-danger p-0" title="Remove" type="button" t-on-click="() => this.removeProduct(line)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

            </div>
            <t t-set-slot="footer">
                <button class="btn text-white" style="background-color: #6a4a5b;" t-on-click="confirm">
                    Send Request
                </button>
                <button class="btn btn-light border" t-on-click="cancel">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>
</templates>
