<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_grooming" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.grooming</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Hide standard print button for internals -->
            <xpath expr="//button[@name='do_print_picking']" position="attributes">
                <attribute name="invisible">picking_type_code == 'internal'</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_download_custom_pdf" string="Print Internal Transfer" type="object" class="oe_highlight" invisible="picking_type_code != 'internal'"/>
                <button name="action_send_whatsapp" string="Send WhatsApp" type="object" icon="fa-whatsapp" class="btn-success oe_highlight" invisible="picking_type_code != 'internal'"/>
            </xpath>
            <!-- Hide standard locations when picking type is internal -->
            <xpath expr="//field[@name='location_id'][@groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible">picking_type_code == 'internal' or picking_type_code == 'incoming'</attribute>
            </xpath>
            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible">picking_type_code == 'internal' or picking_type_code == 'outgoing'</attribute>
            </xpath>
            
            <xpath expr="//field[@name='location_id'][@groups='stock.group_stock_multi_locations']" position="after">
                <field name="custom_source_warehouse_id" string="Source Warehouse" invisible="picking_type_code != 'internal'" required="picking_type_code == 'internal'" readonly="state == 'done'"/>
            </xpath>
            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" position="after">
                <field name="custom_destination_warehouse_id" string="Destination Warehouse" invisible="picking_type_code != 'internal'" required="picking_type_code == 'internal'" readonly="state == 'done'"/>
            </xpath>

            <!-- Add Available Quantity from Source Warehouse (Masaki Back Storage) right after Demand / before Quantity -->
            <xpath expr="//field[@name='move_ids_without_package']//list//field[@name='quantity']" position="before">
                <field name="source_available_qty" string="Available" readonly="1" force_save="1" decoration-danger="source_available_qty &lt; product_uom_qty and parent.state not in ('done', 'cancel')" decoration-success="source_available_qty &gt;= product_uom_qty and parent.state not in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
