<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_grooming_expense_form" model="ir.ui.view">
            <field name="name">grooming.expense.form</field>
            <field name="model">grooming.expense</field>
            <field name="arch" type="xml">
                <form string="Expense">
                    <header>
                        <button name="action_post" string="Post" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Posted" bg_color="text-bg-success" invisible="state != 'posted'"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="E.g. Shampoo Purchase"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="category"/>
                                <field name="amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="payment_method_id"/>
                                <field name="reference"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Receipt">
                                <group>
                                    <field name="receipt_image" widget="image" options="{'size': [0, 400]}"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_grooming_expense_tree" model="ir.ui.view">
            <field name="name">grooming.expense.tree</field>
            <field name="model">grooming.expense</field>
            <field name="arch" type="xml">
                <list string="Expenses" decoration-info="state == 'draft'" decoration-muted="state == 'cancelled'">
                    <field name="date"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="payment_method_id"/>
                    <field name="amount" sum="Total Amount" widget="monetary"/>
                    <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                    <field name="currency_id" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_grooming_expense_search" model="ir.ui.view">
            <field name="name">grooming.expense.search</field>
            <field name="model">grooming.expense</field>
            <field name="arch" type="xml">
                <search string="Search Expenses">
                    <field name="name"/>
                    <field name="category"/>
                    <field name="payment_method_id"/>
                    <filter string="My Expenses" name="my_expenses" domain="[('create_uid', '=', uid)]"/>
                    <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="This Month" name="month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                    <separator/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_grooming_expense_pivot" model="ir.ui.view">
            <field name="name">grooming.expense.pivot</field>
            <field name="model">grooming.expense</field>
            <field name="arch" type="xml">
                <pivot string="Expense Analysis">
                    <field name="date" type="row" interval="month"/>
                    <field name="category" type="col"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <!-- Graph View -->
        <record id="view_grooming_expense_graph" model="ir.ui.view">
            <field name="name">grooming.expense.graph</field>
            <field name="model">grooming.expense</field>
            <field name="arch" type="xml">
                <graph string="Expense Analysis" type="bar">
                    <field name="category"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_grooming_expense" model="ir.actions.act_window">
            <field name="name">Expenses</field>
            <field name="res_model">grooming.expense</field>
            <field name="view_mode">list,form,pivot,graph</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Record your first expense!
                </p>
                <p>
                    Track daily operational costs like supplies, utilities, and staff payments.
                </p>
            </field>
        </record>
    </data>
</odoo>
