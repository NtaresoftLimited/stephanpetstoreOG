<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Website checkout option that spends the customer's Sky Wallet balance (same ledger as POS). -->
    <record id="payment_provider_sky_wallet" model="payment.provider">
        <field name="name">Sky Wallet</field>
        <field name="code">sky_wallet</field>
        <field name="is_live">True</field>
        <field name="is_published">True</field>
        <field name="sequence">5</field>
        <field name="image_128" type="bytes" file="stephans_wallet_rewards/static/src/img/sky-wallet.png"/>
        <field name="redirect_form_view_id" ref="payment.generic_redirect_form"/>
        <field name="allow_tokenization">False</field>
        <field name="allow_express_checkout">False</field>
        <field name="pre_msg" type="html">
            <p>Pay instantly from your Sky Wallet. Top up at our Masaki or Mikocheni store.</p>
        </field>
        <field name="pending_msg" type="html">
            <p>We are confirming your Sky Wallet payment&#8230;</p>
        </field>
        <field name="done_msg" type="html">
            <p>Paid with Sky Wallet. Thank you! Your order is confirmed.</p>
        </field>
    </record>

    <record id="payment_method_sky_wallet" model="payment.method">
        <field name="name">Sky Wallet</field>
        <field name="code">sky_wallet</field>
        <field name="sequence">1</field>
        <field name="active">True</field>
        <field name="provider_id" ref="payment_provider_sky_wallet"/>
        <field name="image" type="bytes" file="stephans_wallet_rewards/static/src/img/sky-wallet.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
    </record>
</odoo>
