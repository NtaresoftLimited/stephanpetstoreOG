<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wise_pos_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wise.pos.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="inside">
                <setting string="Display Stock" help="Show this till's stock on the product cards">
                    <field name="pos_is_display_stock"/>
                    <div class="content-group mt16" invisible="not pos_is_display_stock">
                        <div class="row">
                            <label for="pos_stock_type" class="col-lg-4 o_light_label"/>
                            <field name="pos_stock_type" widget="radio"/>
                        </div>
                        <div class="row">
                            <label for="pos_stock_quantities_refresh_rate" class="col-lg-4 o_light_label"/>
                            <field name="pos_stock_quantities_refresh_rate"/>
                        </div>
                        <div class="row">
                            <label for="pos_low_stock_color" class="col-lg-4 o_light_label"/>
                            <field name="pos_low_stock_color" widget="color_picker"/>
                        </div>
                        <div class="row">
                            <label for="pos_in_stock_color" class="col-lg-4 o_light_label"/>
                            <field name="pos_in_stock_color" widget="color_picker"/>
                        </div>
                    </div>
                </setting>
                <setting string="Stock Location" help="Count stock at this till's location, or across all warehouses">
                    <field name="pos_stock_warehouse" widget="radio"/>
                </setting>
                <setting string="Restrict Out of Stock" help="Block selling more than the stock available (services excepted)">
                    <field name="pos_is_restrict_out_of_stock_products"/>
                </setting>
                <setting string="Only In-Stock Products" help="Hide products with no stock at this till">
                    <field name="pos_only_in_stock_products"/>
                </setting>
                <setting string="Low Stock List" help="Add a Low Stock list to the POS menu">
                    <field name="pos_is_low_stock_screen_visible"/>
                    <div class="content-group mt16" invisible="not pos_is_low_stock_screen_visible">
                        <div class="row">
                            <label for="pos_low_stock_threshold" class="col-lg-4 o_light_label"/>
                            <field name="pos_low_stock_threshold"/>
                        </div>
                    </div>
                </setting>
                <setting string="Margin Restrictions" help="Block or warn on products sold below a minimum margin">
                    <field name="pos_is_restrict_low_margin_products"/>
                    <div class="content-group mt16" invisible="not pos_is_restrict_low_margin_products">
                        <div class="row">
                            <label for="pos_margin_threshold_percent" class="col-lg-4 o_light_label"/>
                            <field name="pos_margin_threshold_percent"/>
                        </div>
                        <div class="row">
                            <label for="pos_margin_restriction_level" class="col-lg-4 o_light_label"/>
                            <field name="pos_margin_restriction_level"/>
                        </div>
                        <div class="row">
                            <label for="pos_margin_check_product_type" class="col-lg-4 o_light_label"/>
                            <field name="pos_margin_check_product_type"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
