<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="wise_pos_stock.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="attributes">
            <attribute name="t-att-class">{'wise-out-of-stock opacity-50': this.wiseStockBadge?.out}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <t t-set="wiseBadge" t-value="this.wiseStockBadge"/>
            <span t-if="wiseBadge"
                class="wise-stock-badge position-absolute top-0 start-0 m-1 px-2 rounded fw-bold"
                t-att-class="wiseBadge.colorClass"
                t-out="wiseBadge.value"/>
        </xpath>
    </t>

    <t t-name="wise_pos_stock.BurgerMenuDialog" t-inherit="point_of_sale.BurgerMenuDialog" t-inherit-mode="extension">
        <xpath expr="//t[@btnLabel.translate='Reload Data']" position="after">
            <t t-if="this.pos.config.is_low_stock_screen_visible"
               t-call="point_of_sale.BurgerDialogMenuButton"
               dataIcon="'inventory_2'"
               onClick="() => { this.props.close(); this.pos.wiseOpenLowStock(); }"
               btnLabel.translate="Low Stock"
            />
        </xpath>
    </t>
</templates>
