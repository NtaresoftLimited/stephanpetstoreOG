<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_stephans_ai_auto_enrich" model="ir.cron">
            <field name="name">Stephan's AI Catalog: Auto-Enrich 5 Products Every 30 Minutes</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_enrich_products(limit=5)</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
