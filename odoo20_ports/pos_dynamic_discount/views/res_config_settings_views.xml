<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dynamic_discount" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.dynamic.discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_discount.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_discount_pc']/.." position="after">
                <div class="row">
                    <label string="Maximum %" for="pos_max_percentage_discount" class="col-lg-3 o_light_label"/>
                    <field name="pos_max_percentage_discount"/>
                </div>
                <div class="row">
                    <label string="Maximum Amount" for="pos_max_fixed_amount_discount" class="col-lg-3 o_light_label"/>
                    <field name="pos_max_fixed_amount_discount"/>
                </div>
                <div class="text-muted small">Discounts above these limits are refused at the till. 0 means no limit.</div>
            </xpath>
        </field>
    </record>
</odoo>
