<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_a4">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: 'Helvetica', 'Arial', sans-serif; color: #333;">
                    
                    <!-- Styles -->
                    <style>
                        .header-box {
                            background-color: #f0f2f5;
                            padding: 20px;
                            border-bottom: 2px solid #333;
                            margin-bottom: 30px;
                        }
                        .section {
                            margin-bottom: 25px;
                        }
                        .section-header {
                            background-color: #e9ecef;
                            padding: 8px 15px;
                            font-weight: bold;
                            text-transform: uppercase;
                            font-size: 14px;
                            border-left: 5px solid #6c757d;
                            margin-bottom: 10px;
                        }
                        .table-clean {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .table-clean th {
                            text-align: left;
                            padding: 8px;
                            border-bottom: 2px solid #dee2e6;
                            font-size: 12px;
                            color: #495057;
                        }
                        .table-clean td {
                            padding: 8px;
                            border-bottom: 1px solid #dee2e6;
                            font-size: 12px;
                        }
                        .text-end { text-align: right; }
                        .text-center { text-align: center; }
                        .fw-bold { font-weight: bold; }
                        .summary-box {
                            background-color: #f8f9fa;
                            padding: 15px;
                            border: 1px solid #dee2e6;
                            border-radius: 5px;
                        }
                        .negative { color: #dc3545; }
                        .positive { color: #28a745; }
                    </style>

                    <!-- Header -->
                    <div class="header-box">
                        <div class="row">
                            <div class="col-6">
                                <img t-if="o.env.company.logo" t-att-src="image_data_uri(o.env.company.logo)" style="max-height: 80px; margin-bottom: 10px;"/>
                                <h2 style="margin: 0; color: #333;"><t t-out="o.report_type_label"/> Sales Report</h2>
                                <div style="margin-top: 5px; font-size: 14px;">
                                    <strong><t t-out="o.env.company.name"/></strong><br/>
                                    <span style="color: #666;">Generated by: <t t-out="user.name"/></span>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <div style="font-size: 12px; color: #666;">
                                    Report Date: <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                </div>
                                <div style="margin-top: 10px; font-size: 14px;">
                                    <strong>Period:</strong><br/>
                                    <t t-if="o._name == 'pos.details.wizard'">
                                        <span t-field="o.date_start_only"/> <i class="fa fa-arrow-right"/> <span t-field="o.date_end_only"/>
                                    </t>
                                    <t t-elif="o._name == 'pos.session'">
                                        <span t-field="o.start_at"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-set="report_data" t-value="o._get_report_data()"/>

                    <!-- Main Content Grid -->
                    <div class="row">
                        <!-- Left Column: Sales -->
                        <div class="col-12 section">
                            <div class="section-header">Sales Breakdown</div>
                            <table class="table-clean">
                                <thead>
                                    <tr>
                                        <th style="width: 40%;">Product</th>
                                        <th style="width: 20%;">Brand</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end">Total (TSh)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="report_data['products']" t-as="prod">
                                        <td><span t-out="prod['name']"/></td>
                                        <td><span t-out="prod['brand']"/></td>
                                        <td class="text-center"><span t-out="prod['qty']"/></td>
                                        <td class="text-end"><span t-out="'{:,.2f}'.format(prod['total'])"/></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">Total Sales (TSh):</td>
                                        <td class="text-end fw-bold"><span t-out="'{:,.2f}'.format(report_data['total_sales'])"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Grooming Section -->
                        <div class="col-12 section">
                            <div class="section-header">Grooming Services</div>
                            <t t-if="report_data.get('grooming_products')">
                                <table class="table-clean">
                                    <thead>
                                        <tr>
                                            <th style="width: 40%;">Service</th>
                                            <th style="width: 20%;">Brand</th>
                                            <th class="text-center">Qty</th>
                                            <th class="text-end">Total (TSh)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="report_data['grooming_products']" t-as="prod">
                                            <td><span t-out="prod['name']"/></td>
                                            <td><span t-out="prod['brand']"/></td>
                                            <td class="text-center"><span t-out="prod['qty']"/></td>
                                            <td class="text-end"><span t-out="'{:,.2f}'.format(prod['total'])"/></td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold">Total Grooming (TSh):</td>
                                            <td class="text-end fw-bold"><span t-out="'{:,.2f}'.format(report_data['total_grooming'])"/></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </t>
                            <t t-else="">
                                <div class="text-center" style="padding: 15px; color: #666; font-style: italic; background-color: #fafafa; border: 1px dashed #ddd; border-radius: 4px;">
                                    No grooming services found for this period.
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Left: Payments -->
                        <div class="col-6 section">
                            <div class="section-header">Payments Received (TSh)</div>
                            <table class="table-clean">
                                <tbody>
                                    <tr t-foreach="report_data['payments']" t-as="pay">
                                        <td><span t-out="pay['method']"/></td>
                                        <td class="text-end"><span t-out="'{:,.2f}'.format(pay['amount'])"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Right: Discounts -->
                        <div class="col-6 section">
                            <div class="section-header">Discounts Given (TSh)</div>
                            <div class="summary-box text-center">
                                <h3 style="margin:0;" class="negative">
                                    <span t-out="'{:,.2f}'.format(report_data['total_discount'])"/>
                                </h3>
                                <small style="color: #666;">Total Value Discounted</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Cash Flow -->
                        <div class="col-12 section">
                            <div class="section-header">Cash Flow Adjustments (TSh)</div>
                            <table class="table-clean">
                                <thead>
                                    <tr>
                                        <th>Reason/Reference</th>
                                        <th class="text-end">Type</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Cash In -->
                                    <tr t-foreach="report_data.get('cash_in', [])" t-as="cin">
                                        <td><span t-out="cin['reason']"/></td>
                                        <td class="text-end positive">Cash In</td>
                                        <td class="text-end positive"><span t-out="'{:,.2f}'.format(cin['amount'])"/></td>
                                    </tr>
                                    <!-- Cash Out -->
                                    <tr t-foreach="report_data['expenses']" t-as="cout">
                                        <td><span t-out="cout['reason']"/></td>
                                        <td class="text-end negative">Cash Out</td>
                                        <td class="text-end negative"><span t-out="'{:,.2f}'.format(cout['amount'])"/></td>
                                    </tr>
                                    <tr t-if="not report_data.get('cash_in') and not report_data['expenses']">
                                        <td colspan="3" class="text-center text-muted">No manual cash adjustments</td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="text-end fw-bold">Total Cash In:</td>
                                        <td></td>
                                        <td class="text-end fw-bold positive"><span t-out="'{:,.2f}'.format(report_data.get('total_cash_in', 0))"/></td>
                                    </tr>
                                    <tr>
                                        <td class="text-end fw-bold">Total Expenses:</td>
                                        <td></td>
                                        <td class="text-end fw-bold negative"><span t-out="'{:,.2f}'.format(report_data.get('total_cash_out', 0))"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Final Summary -->
                    <div class="section">
                        <div class="section-header">Session Summary</div>
                        <div class="row">
                            <div class="col-4">
                                <div class="summary-box text-center">
                                    <div class="text-muted small">Total Transactions</div>
                                    <div class="fw-bold" style="font-size: 1.2em;">
                                        <span t-out="report_data.get('total_orders', 0)"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="summary-box text-center">
                                    <div class="text-muted small">Net Cash Balance (TSh)</div>
                                    <div class="fw-bold positive" style="font-size: 1.2em;">
                                        <span t-out="'{:,.2f}'.format(report_data['net_cash'])"/>
                                    </div>
                                    <small>(Inc. Cash In/Out)</small>
                                </div>
                            </div>
                             <div class="col-4">
                                <div class="summary-box text-center">
                                    <div class="text-muted small">Expected Cash</div>
                                    <!-- Estimated based on Cash Payments + Cash In - Cash Out -->
                                    <!-- Note: We can iterate payments to find 'Cash' methods if name contains Cash -->
                                    <div class="fw-bold" style="font-size: 1.2em;">
                                         --
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </t>
        </t>
    </template>
</odoo>
