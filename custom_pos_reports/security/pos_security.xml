<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Rule to restrict POS Users to only view sales of 1 week for their assigned store -->
        <record id="pos_order_current_week_rule" model="ir.rule">
            <field name="name">POS Order: Current 1 Week for POS Users per Store</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="domain_force">['&amp;', ('date_order', '&gt;=', time.strftime('%Y-%m-%d 00:00:00', time.strptime(time.strftime('%Y-%W-1'), '%Y-%W-%w'))), '|', '|', ('config_id.basic_employee_ids.user_id', 'in', [user.id]), ('config_id.advanced_employee_ids.user_id', 'in', [user.id]), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Keep standard access for POS Managers (Admin) -->
        <record id="pos_order_all_for_managers" model="ir.rule">
            <field name="name">POS Order: All for POS Managers</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Store Expense: Cashiers see their store or own created expenses -->
        <record id="pos_store_expense_user_rule" model="ir.rule">
            <field name="name">Store Expense: Branch POS Users</field>
            <field name="model_id" ref="model_pos_store_expense"/>
            <field name="domain_force">['|', '|', ('pos_config_id.basic_employee_ids.user_id', 'in', [user.id]), ('pos_config_id.advanced_employee_ids.user_id', 'in', [user.id]), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Store Expense: POS Managers see all expenses across all stores -->
        <record id="pos_store_expense_manager_rule" model="ir.rule">
            <field name="name">Store Expense: POS Managers See All</field>
            <field name="model_id" ref="model_pos_store_expense"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
