<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form Inheritance -->
    <record id="product_template_form_view_inherit_brand" model="ir.ui.view">
        <field name="name">product.template.form.view.inherit.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="brand_id" placeholder="Select Brand..." options="{'no_create_edit': False, 'no_quick_create': False}"/>
            </xpath>
        </field>
    </record>

    <!-- Grooming Service Form Inheritance -->
    <record id="grooming_service_view_form_inherit_brand" model="ir.ui.view">
        <field name="name">grooming.service.view.form.inherit.brand</field>
        <field name="model">grooming.service</field>
        <field name="inherit_id" ref="grooming.grooming_service_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="brand_id" placeholder="Select Brand..."/>
            </xpath>
        </field>
    </record>

    <!-- Grooming Service List (Tree) Inheritance -->
    <record id="grooming_service_view_list_inherit_brand" model="ir.ui.view">
        <field name="name">grooming.service.view.list.inherit.brand</field>
        <field name="model">grooming.service</field>
        <field name="inherit_id" ref="grooming.grooming_service_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_addon']" position="after">
                <field name="brand_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
