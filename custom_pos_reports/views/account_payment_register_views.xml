<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_inherit_stephans" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.stephans</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="before">
                <field name="pos_payment_method_id"
                       options="{'no_create': True, 'no_open': True}"
                       string="Payment Method"/>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="ref_number_required" invisible="1"/>
                <field name="reference_number"
                       placeholder="Enter M-Pesa / Tigo Pesa / CRDB / NMB Ref Number"
                       required="ref_number_required"/>
            </xpath>
        </field>
    </record>
</odoo>
