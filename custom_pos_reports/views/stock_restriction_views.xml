<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Restrict administrative stock buttons and financial columns from cashiers in Product Stock List -->
    <record id="view_product_product_stock_tree_cashier" model="ir.ui.view">
        <field name="name">product.product.stock.list.cashier.restriction</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_orderpoints']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//button[@icon='fa-history']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//button[@icon='fa-cubes']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//button[@icon='fa-pencil']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_product_forecast_report']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='incoming_qty']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='outgoing_qty']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='virtual_available']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='avg_cost']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='total_value']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//button[@icon='fa-bar-chart'][1]" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//button[@icon='fa-bar-chart'][2]" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
        </field>
    </record>

    <!-- Restrict stock moves history and reordering rules in editable quant list -->
    <record id="view_stock_quant_tree_editable_cashier" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.cashier.restriction</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_stock_moves']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_orderpoints']" position="attributes">
                <attribute name="groups">stock.group_stock_manager,point_of_sale.group_pos_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
