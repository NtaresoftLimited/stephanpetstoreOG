<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_send_daily_sales_whatsapp" model="ir.cron">
            <field name="name">Daily Sales Report WhatsApp</field>
            <field name="model_id" ref="custom_pos_reports.model_pos_details_wizard"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_daily_sales_whatsapp()</field>
            <!-- 22:00 in East Africa Time (UTC+3) is 19:00 UTC -->
            <field name="nextcall" eval="(DateTime.now().replace(hour=19, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
