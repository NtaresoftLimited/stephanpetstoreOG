<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_abandoned_cart" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.abandoned.cart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Abandoned Cart Stat Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_abandoned_cart_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-basket"
                        invisible="abandoned_cart_log_count == 0">
                    <field name="abandoned_cart_log_count" widget="statinfo" string="Abandoned Logs"/>
                </button>
            </xpath>

            <!-- Add Abandoned Cart Info in Other Info tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Abandoned Cart Recovery" invisible="website_id == False and abandoned_cart_state == 'active'">
                    <group>
                        <group string="Recovery Status">
                            <field name="abandoned_cart_state" widget="badge"
                                   decoration-success="abandoned_cart_state == 'recovered'"
                                   decoration-warning="abandoned_cart_state == 'abandoned'"/>
                            <field name="abandoned_cart_token" readonly="1" groups="base.group_no_one"/>
                        </group>
                        <group string="Recovery Link">
                            <field name="cart_recovery_url" widget="CopyClipboardChar" readonly="1"/>
                        </group>
                    </group>
                    <field name="abandoned_cart_log_ids" readonly="1">
                        <list string="Logs">
                            <field name="abandon_datetime"/>
                            <field name="last_email_sent"/>
                            <field name="emails_sent_count"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
