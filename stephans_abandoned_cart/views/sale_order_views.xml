<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_abandoned_cart" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.abandoned.cart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Abandoned Cart Stat Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_abandoned_cart_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-basket"
                        invisible="abandoned_cart_log_count == 0">
                    <field name="abandoned_cart_log_count" widget="statinfo" string="Abandoned Logs"/>
                </button>
            </xpath>

            <!-- Add Abandoned Cart Info in Other Info tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Abandoned Cart Recovery" invisible="website_id == False and abandoned_cart_state == 'active'">
                    <group>
                        <group string="Recovery Status">
                            <field name="abandoned_cart_state" widget="badge"
                                   decoration-success="abandoned_cart_state == 'recovered'"
                                   decoration-warning="abandoned_cart_state in ('abandoned', 'reminder_sent')"
                                   decoration-muted="abandoned_cart_state == 'cancelled'"/>
                            <field name="abandoned_cart_token_hash" readonly="1" groups="base.group_no_one"/>
                            <field name="abandoned_cart_token_expiry" readonly="1"/>
                        </group>
                        <group string="Single-Use Recovery Actions">
                            <button name="action_generate_recovery_link"
                                    type="object"
                                    string="Generate Fresh Recovery Link"
                                    icon="fa-link"
                                    class="btn btn-outline-primary"
                                    invisible="state not in ('draft', 'sent') or abandoned_cart_state == 'recovered'"/>
                        </group>
                    </group>
                    <field name="abandoned_cart_log_ids" readonly="1">
                        <list string="Logs">
                            <field name="abandon_datetime"/>
                            <field name="channel" widget="badge"/>
                            <field name="actor" widget="badge"/>
                            <field name="emails_sent_count"/>
                            <field name="whatsapp_sent_count"/>
                            <field name="delivery_status" widget="badge"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
