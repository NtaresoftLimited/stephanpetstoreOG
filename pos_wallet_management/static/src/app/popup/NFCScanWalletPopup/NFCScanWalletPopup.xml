<templates id="template" xml:space="preserve">

    <t t-name="pos_wallet_management.NFCScanWalletPopup">
        <Dialog header="false" size="'md'" bodyClass="'overflow-hidden'">
            <div class="text-primary d-flex justify-content-center align-items-center border-bottom">
                <img style="pointer-events: none;" src="/pos_wallet_management/static/description/wallet.png" width="30px"/>
                <span class="fs-1 text-warning mt-2 ms-2" >
                    Sky Wallet
                </span>
            </div>
            <div class="mt-2 d-flex flex-column align-items-center">
                <div class="p-1 w-100">
                    <div class="position-relative w-100 fs-2" style="height: 35px;">
                        <!-- Centered Wallet Name -->
                        <div class="text-left">
                            <span class="fs-2 fw-bolder border-bottom" t-out="props.wallet.name"/>
                        </div>

                        <!-- Right-Aligned Button -->
                        <button 
                            class="btn btn-primary btn-md position-absolute" 
                            style="right: 0; top: 30%; transform: translateY(-50%);" 
                            t-on-click="()=>this._callRechargeWallet(props.wallet.name)">
                            <img style="pointer-events: none;" src="/pos_wallet_management/static/description/recharge_button.png" width="20px" />
                            Recharge
                        </button>
                    </div>


                    <div class="d-flex justify-content-between mt-3 flex-column gap-2">
                        <div class="d-flex flex-row">
                            <span class="fs-3 border-bottom fw-bolder ">Customer : </span>
                            <span class="ms-4 fs-3" t-out="props.wallet.partner_id.name"/>
                        </div>
                        <div class="d-flex flex-row">
                            <span class="fs-3 border-bottom fw-bolder me-3">Balance : </span>
                            <span class="ms-4 fs-3" t-out="props.formatCurrency(props.wallet.amount)"/>
                        </div>
                    </div>
                </div>
                <div t-if="props.wallet.pos_wallet_trans_id and props.wallet.pos_wallet_trans_id.length" class="w-100 mt-2">
                    <div class="text-center">
                        <span class="fs-2 border-bottom">Transaction</span>
                    </div>
                    <div class="overflow-y-auto" style="max-height: 250px;">
                        <div class="orders flex-grow-1">
                            <div class="header-row d-flex text-bg-700 fw-bolder">
                                <div class="col wide p-2">Type</div>
                                <div class="col wide p-2">Amount</div>
                                <div class="col wide p-2">Created By</div>
                                <div class="col wide p-2">Date</div>
                            </div>
                        </div>
                        <t t-if="props.wallet.pos_wallet_trans_id" t-foreach="props.wallet.pos_wallet_trans_id" t-as="trans" t-key="trans_index">        
                            <div class="transaction-row">
                                <div class="col wide p-2 ">
                                    <div t-attf-class="{{trans.payment_type=='CREDIT'?'': 'text-danger'}}"><t t-out="trans.payment_type"></t></div>
                                </div>
                                <div class="col wide p-2">
                                    <div><t t-out="props.formatCurrency(trans.amount)"></t></div>
                                </div>
                                <div class="col wide p-2">
                                    <div><t t-out="trans.created_by.name"></t></div>
                                </div>
                                <div class="col p-2">
                                    <div><t t-out="getDate(trans)"></t></div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.selectCustomer">Select</button>
                <button class="btn btn-secondary" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
