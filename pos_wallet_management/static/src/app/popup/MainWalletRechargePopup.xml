<templates id="template" xml:space="preserve">
    <t t-name="pos_wallet_management.MainWalletRechargePopup">
        <Dialog header="false" footer="false" size="'md'" bodyClass="'p-0 test-webkul'">
            <div class="popup wk_wallet_recharge " style="height:405px; text-align: center;">
                <div class="modal-header drag-handle" style="width:100%">
                    <div class="title" style="font-size:25px; color:#6f42c1;width:100%">
                        <i class="fa fa-times cancel_recharge float-end" style="cursor:pointer" t-on-click="cancel" aria-hidden="true"/>
                    </div>
                </div>
                <div class="" style="height:256px">
                    <img style="pointer-events: none;" src="/pos_wallet_management/static/description/wallet.png" width="70px" height="70px" />
                    <h3 style="font-size:18px">Sky Wallet Recharge</h3>
                    <div class="d-flex justify-content-center align-items-center gap-2">
                        <div class="align-self-start fw-bolder me-2 mt-1">
                            Sky Wallet ID:
                        </div>
                        <div class="d-flex flex-row justify-content-center align-items-center fw-bolder">
                            <div>
                                <input t-on-keyup="wallet_key_press_input" t-att-value="props.wallet_id" class="wallet_input" placeholder="Search Sky Wallet ID" />
                                <div class='wallet-holder'>
                                    <ul>
                                        <li>
                                            <span class='wallet-name'></span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="wallet_details" style="display:none">
                        <table>
                            <tr>
                                <td>
                                    <h3 style="font-size:16px;margin-left:29px">Customer Name</h3>
                                </td>
                                <td>
                                    <h3 class="wallet_customer" style="font-size:16px;padding-left:114px" />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <h3 style="font-size:16px;margin-left:25px">Available Credits</h3>
                                </td>
    
                                <td>
                                    <t t-if="pos and pos.currency and pos.currency.symbol">
                                        <div style="font-size: 17px;font-weight:bold;">
                                            <span class="available_balance" style="padding-left:133px" />
                                        </div>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="footer justify-content-center">
                    <button t-on-click="click_validate_wallet" class="button btn btn-primary validate_wallet mt-3">Proceed</button>
                </div>
            </div>
        </Dialog>

    </t>
</templates>
