<odoo>
    <data>
        <record id="view_pos_config_form_inherit" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.pos_clear_cart</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_interface_section']" position="after">
                    <block title="Sky Wallet">
                        <setting string="Payment screen display" help="Choose how Sky Wallet appears in the POS payment screen.">
                            <field name="pos_show_wallet_type"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

        <record id="pos_wallet_form" model="ir.ui.view">
            <field name="name">pos.wallet</field>
            <field name="model">pos.wallet</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button type="object" class="btn-primary" name="confirm_wallet" string="Confirm" help="Click to change state of the transaction" invisible="state not in ['draft']"/>
                        <button type="action" name="%(action_view_pos_wallet_payment)d" string="Cancel" help="Click to change state of wallet to cancel" invisible="state == 'cancel'"/>
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="currency_id" invisible="1" />
                                <field name="company_id" groups="base.group_multi_company" />
                                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                <field name="nfcid" class="oe_inline o_field_highlight" />
                            </group>
                            <group>
                                <field name="partner_id" readonly="state != 'draft'"/>
                                <field name="created_by" readonly="1" />
                                <field name="reason" invisible="state != 'cancel'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Sky Wallet Transactions">
                                <field name="pos_wallet_trans_id">
                                    <form string="Sky Wallet Transaction">
                                        <group>
                                            <group>
                                                <field name="currency_id" invisible="1" />
                                                <field name="pos_order_id" readonly="1" />
                                                <field name="payment_type" readonly="1" />
                                                <field name="create_date" readonly="1" />
                                                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" />
                                                <field name="trans_reason" readonly="1" />
                                                <field name="partner_id" readonly="1" />
                                                <field name="created_by" readonly="1" />
                                                <field name="original_transaction_id" readonly="1" invisible="payment_type != 'REFUND'" />
                                                <field name="wallet_id" invisible="1" />
                                            </group>
                                        </group>
                                    </form>
                                    <list string="Sky Wallet Transaction" create="false" edit="false" delete="false">
                                        <field name="currency_id" column_invisible="True" />
                                        <field name="name" string="Order"/>
                                        <field name="created_by" />
                                        <field name="create_date" />
                                        <field name="payment_type" />
                                        <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                        <field name="original_transaction_id" optional="hide" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_wallet_filter" model="ir.ui.view">
            <field name="name">pos.wallet</field>
            <field name="model">pos.wallet</field>
            <field name="arch" type="xml">
                <search string="Search Sky Wallet">
                    <field name="partner_id" />
                    <filter name="state_confirm" string="Confirmed" domain="[('state','=','confirm')]" />
                    <filter name="state_cancel" string="Cancel" domain="[('state','=','cancel')]" />
                    <group>
                        <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                        <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="pos_wallet_management.wallet_tree_view">
            <field name="name">Sky Wallet List</field>
            <field name="model">pos.wallet</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list delete="false">
                    <field name="currency_id" column_invisible="True" />
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="create_date" />
                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="pos_wallet_management.pos_wallet_action_window">
            <field name="name">Sky Wallet</field>
            <field name="res_model">pos.wallet</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="pos_wallet_management.view_wallet_filter" />
        </record>

        <record id="pos_wallet_transaction_form_view" model="ir.ui.view">
            <field name="name">Sky Wallet Transaction</field>
            <field name="model">pos.wallet.transaction</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Transaction Form view" edit="false" create="false" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="currency_id" invisible="1" />
                                <field name="pos_order_id" invisible="1" />
                                <field name="name" readonly="1" />
                                <field name="create_date" readonly="1" />
                                <field name="created_by" readonly="1" />
                                <field name="partner_id" readonly="1" />
                                <field name="state" readonly="1" />
                            </group>
                            <group>
                                <field name="payment_type" readonly="1" />
                                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" />
                                <field name="wallet_id" readonly="1" />
                                <field name="original_transaction_id" readonly="1" invisible="payment_type != 'REFUND'" />
                            </group>
                            <group>
                                <field name="trans_reason" readonly="1" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="pos_wallet_form_trans_action_window">
            <field name="name">Sky Wallet Transaction</field>
            <field name="res_model">pos.wallet.transaction</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="pos_wallet_transaction_tree" model="ir.ui.view">
            <field name="name">Sky Wallet Transaction</field>
            <field name="model">pos.wallet.transaction</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list create="false" edit="false" delete="false">
                    <field name="currency_id" column_invisible="True" />
                    <field name="pos_order_id" column_invisible="True" />
                    <field name="name" />
                    <field name="create_date" />
                    <field name="created_by" />
                    <field name="partner_id" />
                    <field name="payment_type" />
                    <field name="state" />
                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" />
                    <field name="trans_reason" />
                    <field name="original_transaction_id" optional="hide" />
                </list>
            </field>
        </record>

        <record id="view_wallet_trans_filter" model="ir.ui.view">
            <field name="name">Sky Wallet Transaction</field>
            <field name="model">pos.wallet.transaction</field>
            <field name="arch" type="xml">
                <search string="Search Sky Wallet Transaction">
                    <field name="partner_id" />
                    <field name="wallet_id" />
                    <field name="name" />
                    <filter name="type_credit" string="Credits" domain="[('payment_type','=','CREDIT')]" />
                    <filter name="type_debit" string="Debits" domain="[('payment_type','=','DEBIT')]" />
                    <filter name="type_refund" string="Refunds" domain="[('payment_type','=','REFUND')]" />
                    <group>
                        <filter name="group_type" string="Transaction Type" context="{'group_by': 'payment_type'}"/>
                        <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="pos_wallet_management.pos_wallet_trans_action_window">
            <field name="name">Sky Wallet Transactions</field>
            <field name="res_model">pos.wallet.transaction</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="pos_wallet_management.view_wallet_trans_filter" />
        </record>

        <record id="pos_wallet_journal_form_view" model="ir.ui.view">
            <field name="name">Pos Payment Method Form</field>
            <field name="model">pos.payment.method</field>
            <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="wallet_method" />
                </xpath>
            </field>
        </record>

        <menuitem id="pos_wallet_management.menu_root" parent="point_of_sale.menu_point_root" name="Sky Wallet" />
        <menuitem name="Wallets" id="pos_wallet_management.menu_transaction_list" parent="pos_wallet_management.menu_root" action="pos_wallet_management.pos_wallet_action_window" />
        <menuitem name="Transactions" id="pos_wallet_management.menu_wallet_transactions" parent="pos_wallet_management.menu_root" action="pos_wallet_management.pos_wallet_trans_action_window" />
    </data>
</odoo>
