<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="pos_whatsapp_receipt" string="WhatsApp Receipts"
                         help="Send the receipt to the customer's WhatsApp from the Send Receipt popup">
                    <field name="pos_whatsapp_receipt"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
