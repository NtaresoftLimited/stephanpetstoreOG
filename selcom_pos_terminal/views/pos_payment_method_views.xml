<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_view_form_inherit_selcon_pos_terminal" model="ir.ui.view">
        <field name="name">pos.payment.method.view.form.inherit</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="payment_provider" position="after">
                <field name="selcom_pos_terminal_id" invisible="payment_provider != 'selcom'" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
