<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="stephans_global_layout" inherit_id="website.layout" name="Stephan's Global Website Chrome">
        <xpath expr="//head" position="inside"><link rel="stylesheet" type="text/css" href="/stephans_website_theme/static/src/css/theme.css?v=20.0.1.7.0"/><link rel="stylesheet" type="text/css" href="/stephans_website_theme/static/src/css/mega_menu.css?v=20.0.1.7.0"/><link rel="stylesheet" type="text/css" href="/stephans_website_theme/static/src/css/shop.css?v=20.0.1.7.0"/></xpath>
        <xpath expr="//header[@id='top']" position="replace"><t t-if="not no_header" t-call="stephans_website_theme.stephans_preview_header"/></xpath>
        <xpath expr="//footer[@id='bottom']" position="replace"><t t-if="not no_footer" t-call="stephans_website_theme.stephans_preview_footer"/></xpath>
    </template>
</odoo>
