<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- GENERIC CONTENT PAGE -->
  <template id="content_page" name="Stephan's Content Page">
    <t t-call="website.layout">
      <t t-set="additional_title"><t t-out="page['title']"/></t>
      <t t-set="meta_description" t-value="page['intro']"/>
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
      <link rel="stylesheet" href="/stephans_website_theme/static/src/css/pages.css"/>
      <main id="wrap" class="oe_structure stephans-theme stephans-content-page">
        <style>#wrapwrap &gt; header#top,#wrapwrap &gt; header.o_header_standard,#wrapwrap &gt; footer:not(.stephans-footer),#wrapwrap &gt; .o_footer{display:none!important}#wrapwrap{padding-top:0!important}</style>
        <section class="content-hero" t-att-class="'content-hero content-hero--' + page_key">
          <div><p class="content-kicker"><t t-out="page['kicker']"/></p><h1><t t-out="page['title']"/></h1><p><t t-out="page['intro']"/></p></div>
          <img t-if="page.get('image')" t-att-src="page['image']" alt=""/>
        </section>
        <section class="content-body">
          <div t-if="page.get('brands')" class="brand-grid">
            <t t-foreach="page['brands']" t-as="brand">
              <a t-att-href="brand[2] if len(brand) &gt; 2 else ('/shop?search=' + brand[0])">
                <img t-if="brand[1]" t-att-src="'/stephans_website_theme/static/src/images/brands/' + brand[1]" t-att-alt="brand[0]"/>
                <div t-else="" class="brand-text-logo"><t t-out="brand[0]"/></div>
                <strong><t t-out="brand[0]"/></strong>
                <span>Explore brand →</span>
              </a>
            </t>
          </div>
          <div class="content-grid">
            <t t-foreach="page['sections']" t-as="section">
              <article>
                <h2><t t-out="section[0]"/></h2>
                <p class="preserve-lines"><t t-out="section[1]"/></p>
                <t t-if="page_key == 'contact'">
                  <a t-if="section[0] == 'Call us'" href="tel:+255786627873">Call Stephan's →</a>
                  <a t-if="section[0] == 'Email'" href="mailto:info@stephanspetstore.co.tz">Send email →</a>
                </t>
              </article>
            </t>
          </div>
          <div t-if="page_key == 'contact'" class="content-cta">
            <h2>Prefer WhatsApp?</h2>
            <p>Message our team for quick help with products, orders or grooming.</p>
            <a href="https://wa.me/255769324445">Talk to us on WhatsApp →</a>
          </div>
        </section>
      </main>
    </t>
  </template>

  <!-- DEDICATED BRAND STOREFRONT PAGE -->
  <template id="brand_page" name="Stephan's Brand Storefront">
    <t t-call="website.layout">
      <t t-set="additional_title"><t t-out="additional_title"/></t>
      <t t-set="meta_description" t-value="meta_description"/>
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
      <link rel="stylesheet" href="/stephans_website_theme/static/src/css/pages.css"/>
      <main id="wrap" class="oe_structure stephans-theme stephans-brand-page">
        <style>
          #wrapwrap &gt; header#top, #wrapwrap &gt; header.o_header_standard, #wrapwrap &gt; footer:not(.stephans-footer), #wrapwrap &gt; .o_footer { display: none !important; }
          #wrapwrap { padding-top: 0 !important; }
          .stephans-brand-hero { background: #fbf8f5; border-bottom: 1px solid #eae3d9; padding: 48px 24px; text-align: center; }
          .stephans-brand-hero__inner { max-width: 900px; margin: 0 auto; }
          .stephans-brand-hero__logo { max-height: 70px; max-width: 200px; object-fit: contain; margin-bottom: 20px; display: inline-block; }
          .stephans-brand-hero__kicker { color: #c77e35; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 8px; }
          .stephans-brand-hero h1 { font-family: 'Playfair Display', Georgia, serif; font-size: 38px; color: #222222; margin-bottom: 14px; }
          .stephans-brand-hero p { font-size: 16px; color: #555555; line-height: 1.6; max-width: 680px; margin: 0 auto 16px; }
          .stephans-brand-badge { display: inline-block; background: #3e220f; color: #fff; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; }
          .stephans-brand-products { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
          .stephans-brand-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px; }
          .stephans-brand-card { background: #fff; border: 1px solid #eae3d9; border-radius: 12px; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; text-decoration: none; color: inherit; }
          .stephans-brand-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(62,34,15,0.08); }
          .stephans-brand-card__image { height: 240px; width: 100%; display: flex; align-items: center; justify-content: center; background: #fafafa; padding: 16px; }
          .stephans-brand-card__image img { max-height: 100%; max-width: 100%; object-fit: contain; }
          .stephans-brand-card__body { padding: 16px; flex-grow: 1; display: flex; flex-direction: column; }
          .stephans-brand-card__category { font-size: 11px; text-transform: uppercase; color: #888; letter-spacing: 0.05em; margin-bottom: 6px; }
          .stephans-brand-card__title { font-size: 15px; font-weight: 600; color: #222; margin-bottom: 10px; line-height: 1.35; flex-grow: 1; }
          .stephans-brand-card__price { font-size: 17px; font-weight: 700; color: #3e220f; margin-bottom: 12px; }
          .stephans-brand-card__btn { display: inline-block; text-align: center; background: #fbf8f5; border: 1px solid #eae3d9; color: #222; padding: 8px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; transition: background 0.2s; }
          .stephans-brand-card:hover .stephans-brand-card__btn { background: #222; color: #fff; border-color: #222; }
          .stephans-brand-empty { text-align: center; padding: 60px 20px; color: #777; }
        </style>

        <section class="stephans-brand-hero">
          <div class="stephans-brand-hero__inner">
            <img t-if="brand.get('logo')" t-att-src="brand['logo']" t-att-alt="brand['name']" class="stephans-brand-hero__logo"/>
            <p class="stephans-brand-hero__kicker"><t t-out="brand.get('kicker', 'Featured Brand')"/></p>
            <h1><t t-out="brand['name']"/></h1>
            <p><t t-out="brand.get('description', '')"/></p>
            <span class="stephans-brand-badge"><t t-out="len(products)"/> Products Available in Dar es Salaam</span>
          </div>
        </section>

        <section class="stephans-brand-products">
          <div t-if="products" class="stephans-brand-grid">
            <t t-foreach="products" t-as="p">
              <a class="stephans-brand-card" t-att-href="p['url']">
                <div class="stephans-brand-card__image">
                  <img t-att-src="p['image_url']" t-att-alt="p['name']" loading="lazy"/>
                </div>
                <div class="stephans-brand-card__body">
                  <span class="stephans-brand-card__category" t-out="p['category']"/>
                  <h3 class="stephans-brand-card__title" t-out="p['name']"/>
                  <div class="stephans-brand-card__price" t-out="p['price_formatted']"/>
                  <span class="stephans-brand-card__btn">View Product →</span>
                </div>
              </a>
            </t>
          </div>
          <div t-else="" class="stephans-brand-empty">
            <h3>No products found under this brand.</h3>
            <p>Check out our full collection of premium pet essentials.</p>
            <a href="/shop" class="stephans-brand-card__btn" style="display:inline-block; margin-top:16px;">Browse All Products →</a>
          </div>
        </section>
      </main>
    </t>
  </template>
</odoo>
