<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="stephans_paw_points_modal" name="Stephan's Paw Points Interactive Modal">
        <!-- =========================================================
             APPLE FROSTED BACKDROP + STEPHAN'S PAW POINTS MODAL
             ========================================================= -->
        <div id="paw-modal-overlay" class="stephans-paw-backdrop stephans-paw-hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="paw-modal-title">
            <div class="stephans-paw-modal" role="document">
                <!-- Close Button -->
                <button type="button" id="paw-modal-close" class="stephans-paw-close" aria-label="Close dialog">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>

                <!-- =========================================================
                     STEP 1: Phone Number Entry
                     ========================================================= -->
                <div id="modal-step-1" class="stephans-paw-step stephans-paw-fade">
                    <!-- Paw Points Coin Icon (transparent PNG, normal size, no background) -->
                    <img src="/stephans_wallet_rewards/static/src/img/paw-points-coin.png" alt="Paw Points" style="width:40px;height:40px;object-fit:contain;display:block;margin:0 0 14px;background:transparent;border:none;"/>

                    <h2 id="paw-modal-title" class="stephans-paw-heading">
                        Earn rewards on every order
                    </h2>
                    <p class="stephans-paw-desc">
                        Verify your WhatsApp number to activate your Paw Points account.
                    </p>

                    <div id="paw-error-box-1" style="display:none;background:#fdf2f2;border:1px solid #f5c6cb;color:#9b1c1c;padding:9px 12px;border-radius:12px;font-size:12px;margin-bottom:12px;text-align:left;"></div>

                    <!-- Phone Input with Inline SVG-Only Flag Selector -->
                    <div class="stephans-paw-field">
                        <label for="paw-phone-input" class="stephans-paw-label">
                            Number
                        </label>
                        <div class="stephans-paw-input-wrap">
                            <button id="flag-picker-btn" type="button" class="stephans-paw-flag-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Select country code">
                                <span id="selected-flag-svg" class="stephans-flag-slot">
                                    <svg width="22" height="15" viewBox="0 0 22 15" class="stephans-flag-svg" xmlns="http://www.w3.org/2000/svg">
                                        <clipPath id="tzc_step1"><rect width="22" height="15" rx="2"/></clipPath>
                                        <g clip-path="url(#tzc_step1)">
                                            <rect width="22" height="15" fill="#1EB53A"/>
                                            <polygon points="22,0 22,15 0,15" fill="#00A3DD"/>
                                            <line x1="0" y1="15" x2="22" y2="0" stroke="#FCD116" stroke-width="5.2"/>
                                            <line x1="0" y1="15" x2="22" y2="0" stroke="#111111" stroke-width="3.2"/>
                                        </g>
                                    </svg>
                                </span>
                                <svg class="stephans-paw-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"/>
                                </svg>
                            </button>
                            <span id="selected-dial-code" class="stephans-paw-dial">+255</span>
                            <input id="paw-phone-input" type="tel" inputmode="tel" placeholder="7XX XXX XXX" autocomplete="tel-national" class="stephans-paw-input" />
                        </div>

                        <!-- SVG Flag Dropdown Menu (Strictly SVG flags, No Emojis) -->
                        <div id="flag-menu" class="stephans-flag-menu stephans-flag-hidden" role="listbox">
                            <button type="button" class="stephans-flag-option" data-country="TZ" data-dial="+255" role="option">
                                <span class="stephans-flag-option__meta">
                                    <span class="stephans-flag-slot">
                                        <svg width="22" height="15" viewBox="0 0 22 15" class="stephans-flag-svg" xmlns="http://www.w3.org/2000/svg">
                                            <clipPath id="tzc_opt"><rect width="22" height="15" rx="2"/></clipPath>
                                            <g clip-path="url(#tzc_opt)">
                                                <rect width="22" height="15" fill="#1EB53A"/>
                                                <polygon points="22,0 22,15 0,15" fill="#00A3DD"/>
                                                <line x1="0" y1="15" x2="22" y2="0" stroke="#FCD116" stroke-width="5.2"/>
                                                <line x1="0" y1="15" x2="22" y2="0" stroke="#111111" stroke-width="3.2"/>
                                            </g>
                                        </svg>
                                    </span>
                                    <span class="stephans-flag-country">Tanzania</span>
                                </span>
                                <span class="stephans-flag-dial">+255</span>
                            </button>
                            <button type="button" class="stephans-flag-option" data-country="KE" data-dial="+254" role="option">
                                <span class="stephans-flag-option__meta">
                                    <span class="stephans-flag-slot">
                                        <svg width="22" height="15" viewBox="0 0 22 15" class="stephans-flag-svg" xmlns="http://www.w3.org/2000/svg">
                                            <rect width="22" height="4.5" y="0" fill="#111111"/>
                                            <rect width="22" height="1" y="4.5" fill="#FFFFFF"/>
                                            <rect width="22" height="4" y="5.5" fill="#BB0000"/>
                                            <rect width="22" height="1" y="9.5" fill="#FFFFFF"/>
                                            <rect width="22" height="4.5" y="10.5" fill="#006600"/>
                                            <ellipse cx="11" cy="7.5" rx="2" ry="3.4" fill="#BB0000" stroke="#FFFFFF" stroke-width="0.6"/>
                                        </svg>
                                    </span>
                                    <span class="stephans-flag-country">Kenya</span>
                                </span>
                                <span class="stephans-flag-dial">+254</span>
                            </button>
                            <button type="button" class="stephans-flag-option" data-country="UG" data-dial="+256" role="option">
                                <span class="stephans-flag-option__meta">
                                    <span class="stephans-flag-slot">
                                        <svg width="22" height="15" viewBox="0 0 22 15" class="stephans-flag-svg" xmlns="http://www.w3.org/2000/svg">
                                            <rect width="22" height="2.5" y="0" fill="#111111"/>
                                            <rect width="22" height="2.5" y="2.5" fill="#FCDC04"/>
                                            <rect width="22" height="2.5" y="5" fill="#D90000"/>
                                            <rect width="22" height="2.5" y="7.5" fill="#111111"/>
                                            <rect width="22" height="2.5" y="10" fill="#FCDC04"/>
                                            <rect width="22" height="2.5" y="12.5" fill="#D90000"/>
                                            <circle cx="11" cy="7.5" r="2.2" fill="#FFFFFF"/>
                                        </svg>
                                    </span>
                                    <span class="stephans-flag-country">Uganda</span>
                                </span>
                                <span class="stephans-flag-dial">+256</span>
                            </button>
                            <button type="button" class="stephans-flag-option" data-country="RW" data-dial="+250" role="option">
                                <span class="stephans-flag-option__meta">
                                    <span class="stephans-flag-slot">
                                        <svg width="22" height="15" viewBox="0 0 22 15" class="stephans-flag-svg" xmlns="http://www.w3.org/2000/svg">
                                            <rect width="22" height="7.5" y="0" fill="#00A1DE"/>
                                            <rect width="22" height="3.75" y="7.5" fill="#FAD201"/>
                                            <rect width="22" height="3.75" y="11.25" fill="#20603D"/>
                                            <circle cx="16.8" cy="3.6" r="1.4" fill="#E5BE01"/>
                                        </svg>
                                    </span>
                                    <span class="stephans-flag-country">Rwanda</span>
                                </span>
                                <span class="stephans-flag-dial">+250</span>
                            </button>
                        </div>
                        <p class="stephans-paw-hint">
                            We’ll send a 6-digit verification code via WhatsApp.
                        </p>
                    </div>

                    <!-- Marketing Opt-in -->
                    <label class="stephans-paw-optin">
                        <input id="paw-optin-checkbox" type="checkbox" checked="checked" class="stephans-paw-checkbox"/>
                        <span class="stephans-paw-optin__text">
                            Send me pet care tips, Paw Points updates, and exclusive offers on WhatsApp.
                        </span>
                    </label>

                    <!-- Submit Button -->
                    <button type="button" id="paw-btn-submit-phone" class="stephans-paw-btn stephans-paw-btn--primary">
                        <svg class="stephans-paw-wa-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                            <path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.49 0 .16 5.33.16 11.9c0 2.1.55 4.15 1.59 5.95L0 24l6.33-1.66a11.85 11.85 0 0 0 5.73 1.46h.01c6.57 0 11.9-5.33 11.9-11.9 0-3.18-1.24-6.17-3.45-8.42zM12.07 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.76.99 1-3.66-.24-.38a9.84 9.84 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.82 9.82 0 0 1 2.9 7c0 5.46-4.44 9.89-9.89 9.89zm5.42-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z"/>
                        </svg>
                        <span>Send code via WhatsApp</span>
                    </button>

                    <!-- Guest Dismiss -->
                    <div class="stephans-paw-footer-link">
                        <button type="button" class="stephans-paw-link-subtle" data-paw-close-trigger="true">
                            Continue browsing as guest
                        </button>
                    </div>
                </div>

                <!-- =========================================================
                     STEP 2: 6-Digit WhatsApp Code Verification
                     ========================================================= -->
                <div id="modal-step-2" class="stephans-paw-step stephans-paw-hidden stephans-paw-fade">
                    <!-- Original WhatsApp Icon SVG -->
                    <div class="stephans-paw-wa-icon-wrap" style="margin:0 0 14px;display:inline-flex;align-items:center;">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="20" cy="20" r="20" fill="#25D366"/>
                            <path d="M29.5 10.5C27 8 23.6 6.6 20 6.6C12.6 6.6 6.6 12.6 6.6 20C6.6 22.4 7.2 24.7 8.4 26.7L6.5 33.5L13.5 31.7C15.4 32.7 17.7 33.3 20 33.3C27.4 33.3 33.4 27.3 33.4 20C33.4 16.4 32 13 29.5 10.5ZM20 30.8C17.9 30.8 15.9 30.2 14.2 29.2L13.8 29L9.6 30.1L10.7 26L10.5 25.6C9.4 23.9 8.8 21.9 8.8 20C8.8 13.8 13.8 8.8 20 8.8C23 8.8 25.8 10 27.9 12.1C30 14.2 31.2 17 31.2 20C31.2 26.2 26.2 30.8 20 30.8ZM25.4 22.9C25.1 22.8 23.6 22 23.3 21.9C23 21.8 22.8 21.7 22.6 22C22.4 22.3 21.8 23 21.6 23.2C21.4 23.4 21.2 23.4 20.9 23.3C20.6 23.1 19.6 22.8 18.5 21.8C17.6 21 17 20 16.8 19.7C16.6 19.4 16.8 19.3 16.9 19.1C17 19 17.2 18.8 17.3 18.6C17.4 18.5 17.5 18.3 17.6 18.1C17.7 17.9 17.6 17.8 17.6 17.6C17.5 17.5 16.9 16 16.6 15.4C16.4 14.8 16.1 14.9 15.9 14.9H15.4C15.2 14.9 14.9 15 14.6 15.3C14.3 15.6 13.6 16.3 13.6 17.7C13.6 19.1 14.6 20.4 14.8 20.6C14.9 20.8 16.8 23.8 19.8 25C22.2 26 23.1 25.8 23.6 25.7C24.3 25.6 25.7 24.8 26 24C26.3 23.2 26.3 22.6 26.2 22.5C26.1 22.4 25.7 22.3 25.4 22.1V22.9Z" fill="white"/>
                        </svg>
                    </div>

                    <h2 class="stephans-paw-heading">
                        Verify your phone number
                    </h2>
                    <p class="stephans-paw-desc">
                        We just sent a 6-digit verification code via WhatsApp to
                        <strong id="paw-display-phone">+255 7XX XXX XXX</strong>.
                        Enter the code below.
                    </p>

                    <div id="paw-info-box-2" style="display:none;background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;padding:9px 12px;border-radius:12px;font-size:12px;margin-bottom:12px;text-align:left;line-height:1.4;"></div>
                    <div id="paw-error-box-2" style="display:none;background:#fdf2f2;border:1px solid #f5c6cb;color:#9b1c1c;padding:9px 12px;border-radius:12px;font-size:12px;margin-bottom:12px;text-align:left;"></div>

                    <!-- 6-digit OTP input -->
                    <div class="stephans-paw-field">
                        <input id="paw-otp-input" type="text" inputmode="numeric" maxlength="6" placeholder="• • • • • •" autocomplete="one-time-code" class="stephans-paw-otp-input" />
                    </div>

                    <!-- Resend & Change Number -->
                    <div class="stephans-paw-resend-wrap">
                        Didn’t get the code?<br/>
                        <button type="button" id="paw-btn-resend" disabled="disabled" class="stephans-paw-resend-btn">
                            Resend the code (<span id="paw-resend-timer">24</span>s)
                        </button>
                        <span class="stephans-paw-sep">or</span>
                        <button type="button" id="paw-btn-change-number" class="stephans-paw-change-btn">
                            use a different number
                        </button>
                    </div>

                    <button type="button" id="paw-btn-verify-otp" class="stephans-paw-btn stephans-paw-btn--gold">
                        Continue
                    </button>
                </div>

                <!-- =========================================================
                     STEP 3: Instant Confirmation & Paw Points Balance
                     ========================================================= -->
                <div id="modal-step-3" class="stephans-paw-step stephans-paw-hidden stephans-paw-fade stephans-paw-step--center">
                    <img src="/stephans_wallet_rewards/static/src/img/paw-points-coin.png" alt="Paw Points" style="width:48px;height:48px;object-fit:contain;display:block;margin:0 auto 14px;background:transparent;border:none;"/>

                    <h2 class="stephans-paw-heading">
                        You’re in!
                    </h2>
                    <p class="stephans-paw-desc">
                        Your Paw Points account is now active for both online orders and in-store visits.
                    </p>

                    <!-- Live Points Card -->
                    <div class="stephans-paw-card">
                        <div class="stephans-paw-card__header">
                            <span class="stephans-paw-card__label">Paw Points Balance</span>
                            <span id="paw-card-value-pill" class="stephans-paw-card__pill">Active Member</span>
                        </div>
                        <div class="stephans-paw-card__score">
                            <span id="paw-card-points" class="stephans-paw-card__number">0</span>
                            <span class="stephans-paw-card__unit">Paw Points</span>
                        </div>
                        <div class="stephans-paw-progress-track">
                            <div id="paw-card-progress" class="stephans-paw-progress-bar" style="width: 15%;"></div>
                        </div>
                        <div id="paw-card-progress-text" class="stephans-paw-card__status stephans-paw-card__status--green">
                            Earn 100 Paw Points to unlock 5,000 TSh off.
                        </div>
                    </div>

                    <button type="button" id="paw-btn-finish" class="stephans-paw-btn stephans-paw-btn--primary">
                        Continue Shopping
                    </button>
                </div>

            </div>
        </div>
    </template>
</odoo>
