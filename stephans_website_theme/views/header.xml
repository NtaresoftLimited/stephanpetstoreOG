                <div class="stephans-mainbar"><div class="stephans-mainbar__inner">
                    <button class="stephans-mobile-menu-btn" type="button" aria-label="Toggle navigation" aria-expanded="false" data-stephans-menu-button="true"><span></span><span></span><span></span></button>
                    <a class="stephans-logo" href="/" aria-label="Stephan's Pet Store Home"><img src="/stephans_website_theme/static/src/images/branding/logo.png" alt="Stephan's Pet Store"/></a>
                    <form class="stephans-searchbar" action="/shop" method="get"><div class="stephans-searchbar__box"><span class="stephans-searchbar__icon">⌕</span><input type="search" name="search" class="stephans-searchbar__input" placeholder="Search For Products, Brands, and More..." autocomplete="off"/><button type="submit" class="stephans-searchbar__btn">Search</button></div></form>
