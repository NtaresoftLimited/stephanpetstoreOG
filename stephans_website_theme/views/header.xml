<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="stephans_preview_header" name="Stephan's Website Header">
        <t t-set="stephans_home" t-value="request.httprequest.path in ('/', '/stephans-preview')"/>
        <t t-set="stephans_is_public" t-value="request.env.user._is_public()"/>
        <header t-attf-class="stephans-master-header #{'is-home' if stephans_home else 'is-inner'}" data-stephans-header="true">
            <style>
                .stephans-master-header{width:100%;position:sticky;top:0;z-index:1040;background:#fff;}
                .stephans-homebar__logo img,.stephans-logo img{height:38px;width:auto;object-fit:contain;display:block;}
                .stephans-topbar-icon{width:14px;height:14px;object-fit:contain;display:inline-block;vertical-align:middle;}
                .stephans-searchbar__icon-img{width:16px;height:16px;object-fit:contain;}
                .stephans-action-item__icon-wrap img,.stephans-action-icon{width:18px;height:18px;object-fit:contain;}
                .stephans-nav-icon{width:18px;height:18px;object-fit:contain;display:inline-block;vertical-align:middle;}
                .stephans-mega{display:none;}
                .stephans-mega__group-icon{width:28px;height:28px;object-fit:contain;display:inline-block;vertical-align:middle;}
                .stephans-homebar__actions img{width:16px;height:16px;object-fit:contain;}
            </style>
            <div class="stephans-homebar">
                <button class="stephans-homebar__menu" type="button" aria-label="Open navigation" data-stephans-menu-button="true"><span></span><span></span><span></span></button>
                <a href="/" class="stephans-homebar__logo"><img src="/stephans_website_theme/static/src/images/branding/logo.png" alt="Stephan's Pet Store"/></a>
                <nav class="stephans-homebar__nav" aria-label="Primary navigation"><span class="stephans-homebar__indicator" aria-hidden="true"></span><a href="/shop">Shop</a><a href="/grooming">Grooming</a><a href="/about">About</a><a href="/contact">Contact</a></nav>
                <div class="stephans-homebar__actions">
                    <a href="/shop" aria-label="Search"><img src="/stephans_website_theme/static/src/images/icons/icon-search-glass.png" alt=""/></a>
                    <a t-att-href="'/web/login/whatsapp?redirect=%2Fmy' if stephans_is_public else '/my'" t-att-aria-label="'Log in' if stephans_is_public else 'My account'"><img src="/stephans_website_theme/static/src/images/icons/icon-profile-user.png" alt=""/></a>
                    <a href="/shop/cart" aria-label="Cart"><img src="/stephans_website_theme/static/src/images/icons/icon-shopping-bag.png" alt=""/></a>
                </div>
            </div>

            <div class="stephans-retail-header">
                <div class="stephans-topbar">
                    <div class="stephans-topbar__inner">
                        <div class="stephans-topbar__announcement">Now Delivering Across Tanzania</div>
                        <div class="stephans-topbar__links">
                            <a href="tel:+255786627873" class="stephans-topbar__link">
                                <img src="/stephans_website_theme/static/src/images/icons/icon-phone.svg" alt="" class="stephans-topbar-icon"/>
                                Call Us
                            </a>
                            <a href="mailto:info@stephanspetstore.co.tz" class="stephans-topbar__link">
                                <img src="/stephans_website_theme/static/src/images/icons/icon-mail.svg" alt="" class="stephans-topbar-icon"/>
                                Email Us
                            </a>
                            <a href="https://wa.me/255769324445" target="_blank" rel="noopener" class="stephans-topbar__link stephans-topbar__link--wa">
                                <img src="/stephans_website_theme/static/src/images/icons/whatsapp-color.svg" alt="" class="stephans-topbar-icon"/>
                                Chat With Us
                            </a>
                        </div>
                    </div>
                </div>

                <div class="stephans-mainbar">
                    <div class="stephans-mainbar__inner">
                        <button class="stephans-mobile-menu-btn" type="button" aria-label="Toggle navigation" aria-expanded="false" data-stephans-menu-button="true"><span></span><span></span><span></span></button>
                        <a class="stephans-logo" href="/" aria-label="Stephan's Pet Store Home"><img src="/stephans_website_theme/static/src/images/branding/logo.png" alt="Stephan's Pet Store"/></a>
                        <form class="stephans-searchbar" action="/shop" method="get">
                            <div class="stephans-searchbar__box">
                                <img src="/stephans_website_theme/static/src/images/icons/icon-search-glass.png" alt="" class="stephans-searchbar__icon-img"/>
                                <input type="search" name="search" class="stephans-searchbar__input" placeholder="Search For Products, Brands, and More..." autocomplete="off"/>
                                <button type="submit" class="stephans-searchbar__btn">Search</button>
                            </div>
                        </form>
                        <div class="stephans-actions">
                            <a t-att-href="'/web/login/whatsapp?redirect=%2Fmy' if stephans_is_public else '/my'" class="stephans-action-item">
                                <span class="stephans-action-item__icon-wrap">
                                    <img src="/stephans_website_theme/static/src/images/icons/icon-profile-user.png" alt="" class="stephans-action-icon"/>
                                </span>
                                <span class="stephans-action-item__label" t-out="'Log in' if stephans_is_public else 'Account'"/>
                            </a>
                            <a href="/stores" class="stephans-action-item">
                                <span class="stephans-action-item__icon-wrap">
                                    <img src="/stephans_website_theme/static/src/images/icons/icon-location-pin.svg" alt="Location" class="stephans-action-icon"/>
                                </span>
                                <span class="stephans-action-item__label">Location</span>
                            </a>
                            <a href="/shop/wishlist" class="stephans-action-item">
                                <span class="stephans-action-item__icon-wrap">
                                    <img src="/stephans_website_theme/static/src/images/icons/icon-wishlist-heart.svg" alt="Wishlist" class="stephans-action-icon"/>
                                </span>
                                <span class="stephans-action-item__label">Wishlist</span>
                            </a>
                            <a href="/shop/cart" class="stephans-action-item stephans-action-item--cart">
                                <span class="stephans-action-item__icon-wrap">
                                    <img src="/stephans_website_theme/static/src/images/icons/icon-shopping-bag.png" alt="Bag" class="stephans-action-icon"/>
                                    <t t-set="website_sale_order" t-value="request.session.get('sale_order_id') and env['sale.order'].sudo().browse(request.session['sale_order_id'])"/>
                                    <t t-set="cart_qty" t-value="website_sale_order and website_sale_order.cart_quantity or 0"/>
                                    <span t-if="cart_qty &gt; 0" class="stephans-cart-badge" t-out="cart_qty"/>
                                </span>
                                <span class="stephans-action-item__label">Bag</span>
                            </a>
                        </div>
                    </div>
                </div>

                <nav class="stephans-nav-strip" id="stephans-nav-drawer" aria-label="Product navigation" data-stephans-menu="true">
                    <div class="stephans-nav-strip__inner">
                        <div class="stephans-nav-drawer-head">
                            <a href="/" aria-label="Stephan's Pet Store Home"><img src="/stephans_website_theme/static/src/images/branding/logo.png" alt="Stephan's Pet Store"/></a>
                            <button type="button" class="stephans-nav-drawer-close" aria-label="Close navigation" data-stephans-menu-close="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
                        </div>
                        <ul class="stephans-nav-list">
                            <li class="stephans-mega-item" data-stephans-mega="true"><button type="button" aria-expanded="false" aria-controls="mega-menu-dogs"><img src="/stephans_website_theme/static/src/images/icons/minimalist-dog.png" alt="" class="stephans-nav-animal" loading="lazy"/><span class="stephans-nav-label">Dog</span><span class="stephans-nav-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><t t-call="stephans_website_theme.mega_dogs"/></li>
                            <li class="stephans-mega-item" data-stephans-mega="true"><button type="button" aria-expanded="false" aria-controls="mega-menu-cats"><img src="/stephans_website_theme/static/src/images/icons/minimalist-cat.png" alt="" class="stephans-nav-animal" loading="lazy"/><span class="stephans-nav-label">Cat</span><span class="stephans-nav-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><t t-call="stephans_website_theme.mega_cats"/></li>
                            <li class="stephans-mega-item" data-stephans-mega="true"><button type="button" aria-expanded="false" aria-controls="mega-menu-birds"><img src="/stephans_website_theme/static/src/images/icons/minimalist-bird.png" alt="" class="stephans-nav-animal" loading="lazy"/><span class="stephans-nav-label">Birds</span><span class="stephans-nav-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><t t-call="stephans_website_theme.mega_birds"/></li>
                            <li class="stephans-mega-item" data-stephans-mega="true"><button type="button" aria-expanded="false" aria-controls="mega-menu-small-pets"><img src="/stephans_website_theme/static/src/images/icons/minimalist-rabbit.png" alt="" class="stephans-nav-animal" loading="lazy"/><span class="stephans-nav-label">Small Animals</span><span class="stephans-nav-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><t t-call="stephans_website_theme.mega_small_animals"/></li>
                            <li><a href="/allbrands" class="stephans-nav-brands">Brands</a></li>
                            <li><a href="/grooming" class="stephans-nav-highlight"><img src="/stephans_website_theme/static/src/images/icons/grooming-scissors.png" alt="" class="stephans-nav-icon"/> Grooming</a></li>
                            <li class="stephans-nav-mobile-only"><a href="/about">About</a></li>
                            <li class="stephans-nav-mobile-only"><a href="/contact">Contact</a></li>
                        </ul>
                        <div class="stephans-nav-locator-wrap">
                            <a href="/stores" class="stephans-nav-locator"><img src="/stephans_website_theme/static/src/images/branding/favicon.png" alt="" class="stephans-nav-icon"/> Store Locator</a>
                        </div>
                    </div>
                    <!-- Apple-style Backdrop Overlay -->
                    <div class="stephans-backdrop" aria-hidden="true" data-stephans-backdrop="true"></div>
                </nav>
            </div>
        </header>
    </template>

