    <template id="mega_group" name="Mega Menu Group">
        <article t-attf-class="stephans-mega__group #{'is-extra' if extra else ''}">
            <t t-set="group_url" t-value="'/shop?search=' + title.replace(' ', '+')"/>
            <h4>
                <img t-att-src="icon" alt="" class="stephans-mega__group-icon" loading="lazy"/>
                <a t-att-href="group_url" t-out="title"/>
            </h4>
            <ul>
                <li t-foreach="items" t-as="item">
                    <a t-att-href="'/shop?search=' + item.replace(' ', '+')" t-out="item"/>
                </li>
            </ul>
            <button t-if="len(items) &gt; 3" type="button" class="stephans-mega__all" data-group-toggle="true" aria-expanded="false">
                <span>View all</span><span class="stephans-nav-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
            </button>
        </article>
    </template>
