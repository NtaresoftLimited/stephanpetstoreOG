<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_sky_daily_stock" model="report.paperformat">
        <field name="name">Daily Stock A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_sky_daily_stock" model="ir.actions.report">
        <field name="name">Daily Stock Report</field>
        <field name="model">sky.daily.stock.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sky_dashboard.report_sky_daily_stock</field>
        <field name="paperformat_id" ref="paperformat_sky_daily_stock"/>
        <field name="print_report_name">'Stock Report - %s - %s' % ('All Warehouses' if len(object) &gt; 1 else object.warehouse_id.name, (object[0].report_date.strftime('%d %b %Y') if not object[0].date_end or object[0].date_end == object[0].report_date else '%s to %s' % (object[0].report_date.strftime('%d %b %Y'), object[0].date_end.strftime('%d %b %Y'))))</field>
    </record>

    <template id="report_sky_daily_stock">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    @page {
                        margin: 5mm 2mm 5mm 2mm;
                    }
                    html, body {
                        margin: 0 !important;
                        padding: 0 !important;
                        width: 100% !important;
                    }
                    .article, .page {
                        width: 100% !important;
                        max-width: 100% !important;
                        margin: 0 !important;
                        padding: 0 4px !important;
                    }
                    .container, .container-fluid {
                        width: 100% !important;
                        max-width: 100% !important;
                        margin: 0 !important;
                        padding: 0 !important;
                    }
                    table.daily-stock-table {
                        width: 100% !important;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }
                    table.daily-stock-table th, table.daily-stock-table td {
                        box-sizing: border-box;
                    }
                </style>
                <t t-set="page_size" t-value="12"/>
                <t t-foreach="docs" t-as="o">
                    <t t-set="all_lines" t-value="o.line_ids"/>
                    <t t-set="total_pages" t-value="(len(all_lines) + page_size - 1) // page_size if all_lines else 1"/>
                    <t t-foreach="range(total_pages)" t-as="page_idx">
                        <t t-set="page_lines" t-value="all_lines[page_idx * page_size : (page_idx + 1) * page_size]"/>
                        <div class="page" t-attf-style="#{'page-break-before: always;' if (not o_first or page_idx &gt; 0) else ''} page-break-inside: avoid; font-family: Arial, sans-serif; color: #222; width: 100% !important; max-width: 100% !important; margin: 0 !important; padding: 0 4px !important;">
                            <div style="border-bottom: 2px solid #c77e35; padding-bottom: 6px; margin-bottom: 8px; display: table; width: 100%;">
                                <div style="display: table-cell; vertical-align: bottom;">
                                    <div style="font-size: 10px; font-weight: 700; letter-spacing: 1.5px; color: #c77e35;">STEPHAN'S PET STORE</div>
                                    <h2 style="margin: 2px 0 0 0; color: #4e2a15; font-size: 17px; font-weight: 700;">
                                        <span t-if="o.date_end and o.date_end != o.report_date">Stock Report · </span>
                                        <span t-else="">Daily Stock · </span>
                                        <span t-field="o.warehouse_id.name"/>
                                        <small t-if="o.pos_config_id and o.pos_config_id.name != o.warehouse_id.name" style="font-size: 12px; color: #777; font-weight: normal;"> (<span t-field="o.pos_config_id.name"/>)</small>
                                    </h2>
                                </div>
                                <div style="display: table-cell; vertical-align: bottom; text-align: right; color: #555; font-size: 11px; font-weight: 600;">
                                    <div>
                                        <span t-field="o.report_date" t-options='{"widget": "date"}'/>
                                        <t t-if="o.date_end and o.date_end != o.report_date">
                                            – <span t-field="o.date_end" t-options='{"widget": "date"}'/>
                                        </t>
                                    </div>
                                    <div style="font-size: 10px; color: #888; font-weight: normal; margin-top: 2px;">
                                        Page <span t-out="page_idx + 1"/> of <span t-out="total_pages"/> (<span t-out="len(page_lines)"/> products)
                                    </div>
                                </div>
                            </div>
                            <table class="daily-stock-table" style="width: 100%; border-collapse: collapse; font-size: 11px; table-layout: fixed;">
                                <thead>
                                    <tr style="background: #f7f4ee; color: #4e2a15; font-size: 11px;">
                                        <th style="padding: 6px 4px; border: 1px solid #e5dfd5; width: 84px; text-align: center;">Photo</th>
                                        <th style="padding: 6px 8px; border: 1px solid #e5dfd5; text-align: left;">Product</th>
                                        <th style="padding: 6px 4px; border: 1px solid #e5dfd5; width: 54px; text-align: center;">Open</th>
                                        <th style="padding: 6px 4px; border: 1px solid #e5dfd5; width: 54px; text-align: center;">Sold</th>
                                        <th style="padding: 6px 4px; border: 1px solid #e5dfd5; width: 54px; text-align: center;">Return</th>
                                        <th style="padding: 6px 4px; border: 1px solid #e5dfd5; width: 54px; text-align: center;">Transfer</th>
                                        <th style="padding: 6px 4px; border: 1px solid #e5dfd5; width: 54px; text-align: center;">Adj</th>
                                        <th style="padding: 6px 4px; border: 1px solid #e5dfd5; width: 58px; text-align: center;">Close</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="page_lines" t-as="line" style="height: 76px; page-break-inside: avoid;">
                                        <td style="padding: 2px 4px; border: 1px solid #eee; text-align: center; vertical-align: middle; width: 84px; background: transparent;">
                                            <t t-set="img_uri" t-value="line.get_pdf_image_uri()"/>
                                            <img t-if="img_uri" t-att-src="img_uri" style="width: 72px; height: 72px; object-fit: contain; display: inline-block; border: 0; border-radius: 0; background: transparent; box-shadow: none;"/>
                                            <span t-else="" style="color: #bbb; font-size: 8px; background: transparent; border: 0;">No photo</span>
                                        </td>
                                        <td style="padding: 4px 8px; border: 1px solid #eee; vertical-align: middle; font-weight: 500; font-size: 11px; word-wrap: break-word;">
                                            <span t-field="line.product_id.display_name"/>
                                        </td>
                                        <td style="padding: 4px; border: 1px solid #eee; text-align: center; vertical-align: middle; font-size: 11px;"><span t-field="line.opening_qty"/></td>
                                        <td style="padding: 4px; border: 1px solid #eee; text-align: center; vertical-align: middle; font-size: 11px;"><span t-field="line.sold_qty"/></td>
                                        <td style="padding: 4px; border: 1px solid #eee; text-align: center; vertical-align: middle; font-size: 11px;"><span t-field="line.returned_qty"/></td>
                                        <td style="padding: 4px; border: 1px solid #eee; text-align: center; vertical-align: middle; font-size: 11px;"><span t-field="line.transfer_qty"/></td>
                                        <td style="padding: 4px; border: 1px solid #eee; text-align: center; vertical-align: middle; font-size: 11px;"><span t-field="line.adjustment_qty"/></td>
                                        <td style="padding: 4px; border: 1px solid #eee; text-align: center; vertical-align: middle; font-weight: 700; font-size: 11.5px; color: #4e2a15;"><span t-field="line.closing_qty"/></td>
                                    </tr>
                                </tbody>
                                <tfoot t-if="page_idx + 1 == total_pages">
                                    <tr style="background: #f7f4ee; font-weight: bold; color: #4e2a15; font-size: 11px;">
                                        <td colspan="2" style="padding: 6px 8px; border: 1px solid #e5dfd5; text-align: right;">Total for <span t-field="o.warehouse_id.name"/>:</td>
                                        <td style="padding: 6px 4px; border: 1px solid #e5dfd5; text-align: center;"><span t-out="'%.0f' % sum(line.opening_qty for line in all_lines)"/></td>
                                        <td style="padding: 6px 4px; border: 1px solid #e5dfd5; text-align: center;"><span t-out="'%.0f' % sum(line.sold_qty for line in all_lines)"/></td>
                                        <td style="padding: 6px 4px; border: 1px solid #e5dfd5; text-align: center;"><span t-out="'%.0f' % sum(line.returned_qty for line in all_lines)"/></td>
                                        <td style="padding: 6px 4px; border: 1px solid #e5dfd5; text-align: center;"><span t-out="'%.0f' % sum(line.transfer_qty for line in all_lines)"/></td>
                                        <td style="padding: 6px 4px; border: 1px solid #e5dfd5; text-align: center;"><span t-out="'%.0f' % sum(line.adjustment_qty for line in all_lines)"/></td>
                                        <td style="padding: 6px 4px; border: 1px solid #e5dfd5; text-align: center;"><span t-out="'%.0f' % sum(line.closing_qty for line in all_lines)"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                            <div style="margin-top: 6px; font-size: 9px; color: #888; display: table; width: 100%;">
                                <div style="display: table-cell;">Generated <span t-field="o.generated_at"/></div>
                                <div style="display: table-cell; text-align: right;">Showing items <span t-out="page_idx * page_size + 1"/>–<span t-out="page_idx * page_size + len(page_lines)"/> of <span t-out="len(all_lines)"/></div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
