<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sky_dashboard" model="ir.actions.client">
        <field name="name">SKY</field>
        <field name="tag">sky.dashboard</field>
    </record>

    <!-- Root menu: Restricted to Administrator only. -->
    <menuitem id="menu_sky_root"
              name="SKY"
              web_icon="sky_dashboard,static/description/icon.png"
              groups="base.group_system"
              sequence="12"/>

    <!-- Submenus under SKY -->
    <menuitem id="menu_sky_dashboard"
              name="Dashboard"
              parent="menu_sky_root"
              action="action_sky_dashboard"
              groups="base.group_system"
              sequence="1"/>

    <menuitem id="menu_sky_replenishments"
              name="Replenishment Approvals"
              parent="menu_sky_root"
              action="grooming.action_grooming_stock_request"
              groups="base.group_system"
              sequence="5"/>

    <!-- Replace any groups left by older module versions: SKY is admin-only. -->
    <record id="menu_sky_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="menu_sky_dashboard" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="menu_sky_replenishments" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
</odoo>
