<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sky_dashboard" model="ir.actions.client">
        <field name="name">SKY</field>
        <field name="tag">sky.dashboard</field>
    </record>

    <record id="action_sky_pricing_dashboard" model="ir.actions.client">
        <field name="name">Pricing &amp; Valuation</field>
        <field name="tag">sky.dashboard</field>
        <field name="params" eval="{'default_tab': 'pricing'}"/>
        <field name="context">{'default_tab': 'pricing'}</field>
    </record>

    <!--
        Loyalty is intentionally backed by Odoo's native loyalty.card model.
        SKY only provides administrator entry points and does not duplicate or
        alter customer balances.
    -->
    <record id="action_sky_loyalty_points" model="ir.actions.act_window">
        <field name="name">Loyalty Points</field>
        <field name="res_model">loyalty.card</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'program_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No loyalty points records yet.</p>
            <p>Customer balances are created and updated by Odoo's native loyalty programs.</p>
        </field>
    </record>

    <record id="action_sky_loyalty_members" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">loyalty.card</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_id', '!=', False)]</field>
        <field name="context">{'group_by': 'partner_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No loyalty members yet.</p>
            <p>Members appear here when a customer is linked to a native Odoo loyalty card.</p>
        </field>
    </record>

    <record id="action_sky_wallet_transactions" model="ir.actions.act_window">
        <field name="name">Sky Wallet Transactions</field>
        <field name="res_model">pos.wallet.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'partner_id'}</field>
    </record>

    <!-- Root menu: Restricted to Administrator only. -->
    <menuitem id="menu_sky_root"
              name="SKY"
              web_icon="sky_dashboard,static/description/icon.png"
              groups="base.group_system"
              sequence="12"/>

    <!-- Submenus under SKY -->
    <menuitem id="menu_sky_dashboard"
              name="Dashboard"
              parent="menu_sky_root"
              action="action_sky_dashboard"
              groups="base.group_system"
              sequence="1"/>

    <menuitem id="menu_sky_pricing"
              name="Pricing &amp; Valuation"
              parent="menu_sky_root"
              action="action_sky_pricing_dashboard"
              groups="base.group_system"
              sequence="2"/>

    <menuitem id="menu_sky_loyalty_points"
              name="Loyalty Points"
              parent="menu_sky_root"
              action="action_sky_loyalty_points"
              groups="base.group_system"
              sequence="3"/>

    <menuitem id="menu_sky_loyalty_members"
              name="Members"
              parent="menu_sky_root"
              action="action_sky_loyalty_members"
              groups="base.group_system"
              sequence="4"/>

    <menuitem id="menu_sky_wallet"
              name="Sky Wallet"
              parent="menu_sky_root"
              action="pos_wallet_management.pos_wallet_action_window"
              groups="base.group_system"
              sequence="5"/>

    <menuitem id="menu_sky_wallet_transactions"
              name="Wallet Transactions"
              parent="menu_sky_root"
              action="action_sky_wallet_transactions"
              groups="base.group_system"
              sequence="6"/>

    <menuitem id="menu_sky_replenishments"
              name="Replenishment Approvals"
              parent="menu_sky_root"
              action="grooming.action_grooming_stock_request"
              groups="base.group_system"
              sequence="7"/>

</odoo>
