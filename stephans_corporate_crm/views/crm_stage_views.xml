<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stages Tree View -->
    <record id="view_corporate_crm_stage_tree" model="ir.ui.view">
        <field name="name">corporate.crm.stage.list</field>
        <field name="model">corporate.crm.stage</field>
        <field name="arch" type="xml">
            <list string="Pipeline Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_won"/>
                <field name="is_lost"/>
                <field name="fold"/>
                <field name="requirements"/>
            </list>
        </field>
    </record>

    <!-- Stages Form View -->
    <record id="view_corporate_crm_stage_form" model="ir.ui.view">
        <field name="name">corporate.crm.stage.form</field>
        <field name="model">corporate.crm.stage</field>
        <field name="arch" type="xml">
            <form string="Pipeline Stage">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Stage Name"/>
                        <h1><field name="name" placeholder="e.g. Needs Assessment"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="fold"/>
                        </group>
                        <group>
                            <field name="is_won"/>
                            <field name="is_lost"/>
                        </group>
                    </group>
                    <group string="Requirements &amp; Checklist">
                        <field name="requirements" placeholder="Guidance for Key Account Managers in this stage..." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_corporate_crm_stages" model="ir.actions.act_window">
        <field name="name">Pipeline Stages</field>
        <field name="res_model">corporate.crm.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Lost Reasons Tree & Form -->
    <record id="view_corporate_crm_lost_reason_tree" model="ir.ui.view">
        <field name="name">corporate.crm.lost.reason.list</field>
        <field name="model">corporate.crm.lost.reason</field>
        <field name="arch" type="xml">
            <list string="Lost Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_corporate_crm_lost_reasons" model="ir.actions.act_window">
        <field name="name">Lost Reasons</field>
        <field name="res_model">corporate.crm.lost.reason</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
