<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_whatsapp" model="ir.ui.view">
        <field name="name">pos.order.form.whatsapp</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp_receipt" string="WhatsApp Receipt" type="object" class="btn-secondary" icon="fa-whatsapp" invisible="not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
