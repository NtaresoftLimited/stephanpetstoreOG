<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Native Odoo /web/login: submit without waiting for the lazy JS bundle + "Continue with WhatsApp" -->
    <template id="web_login_whatsapp_button" name="Login with WhatsApp Button" inherit_id="web.login">
        <xpath expr="//form[@data-captcha='login']" position="attributes">
            <attribute name="t-attf-class">oe_login_form o_no_wait_lazy_js #{'' if login else 'd-none'}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="attributes">
            <attribute name="class" add="o_no_wait_lazy_js" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="inside">
            <div class="o_wa_divider"><span>or</span></div>
            <a t-attf-href="/web/login/whatsapp?#{keep_query('redirect')}" class="btn o_wa_btn">
                <img src="/whatsapp_connector/static/src/img/whatsapp-white.svg" alt="" class="o_wa_btn_icon"/>
                <span>Continue with WhatsApp</span>
            </a>
        </xpath>
    </template>

    <!-- 2. Dedicated WhatsApp OTP Login Page (/web/login/whatsapp) -->
    <template id="whatsapp_login" name="WhatsApp Customer Login">
        <t t-call="web.login_layout">
            <div class="o_wa_login">
                <div class="o_wa_login_head">
                    <span class="o_wa_login_badge">
                        <img src="/whatsapp_connector/static/src/img/whatsapp.svg" alt="" class="o_wa_icon"/>
                        WhatsApp Login
                    </span>
                    <h2 t-if="step == 'phone'">Sign in to your account</h2>
                    <h2 t-if="step == 'otp'">Enter your code</h2>
                    <p t-if="step == 'phone'">
                        Enter your WhatsApp number and we'll send you a 6-digit login code.
                        New customer? An account is created for you automatically.
                    </p>
                    <p t-if="step == 'otp'">
                        We sent a 6-digit code to <strong t-out="phone"/> on WhatsApp.
                    </p>
                </div>

                <div class="o_wa_alert o_wa_alert_error" t-if="error" role="alert">
                    <i class="oi" data-icon="error"/>
                    <span t-out="error"/>
                </div>
                <div class="o_wa_alert o_wa_alert_ok" t-if="message" role="status">
                    <i class="oi" data-icon="check_circle"/>
                    <span t-out="message"/>
                </div>

                <!-- STEP 1: WhatsApp phone number -->
                <form t-if="step == 'phone'" action="/web/login/whatsapp" method="post" class="o_no_wait_lazy_js">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="action" value="send_otp"/>
                    <input type="hidden" name="redirect" t-att-value="redirect"/>

                    <label for="wa_phone" class="o_wa_label">WhatsApp number</label>
                    <div class="o_wa_input_group">
                        <span class="o_wa_input_prefix">
                            <img src="/whatsapp_connector/static/src/img/whatsapp.svg" alt="" class="o_wa_icon"/>
                        </span>
                        <input type="tel" name="phone" id="wa_phone" t-att-value="phone"
                               class="form-control" placeholder="0769 324 445 or +255..."
                               required="required" autofocus="autofocus" autocomplete="tel" inputmode="tel"/>
                    </div>

                    <label for="wa_name" class="o_wa_label mt-3">Your name <span class="o_wa_optional">(optional, for new customers)</span></label>
                    <input type="text" name="customer_name" id="wa_name" t-att-value="customer_name"
                           class="form-control" placeholder="e.g. Amina Juma" autocomplete="name" maxlength="120"/>

                    <button type="submit" class="btn o_wa_btn o_no_wait_lazy_js mt-4">
                        <img src="/whatsapp_connector/static/src/img/whatsapp-white.svg" alt="" class="o_wa_btn_icon"/>
                        <span>Send code via WhatsApp</span>
                    </button>
                </form>

                <!-- STEP 2: 6-digit code -->
                <t t-if="step == 'otp'">
                    <form action="/web/login/whatsapp" method="post" class="o_no_wait_lazy_js">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="action" value="verify_otp"/>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>

                        <label for="wa_otp" class="o_wa_label">6-digit code</label>
                        <input type="text" name="otp" id="wa_otp"
                               class="form-control o_wa_otp_input"
                               placeholder="••••••" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                               required="required" autofocus="autofocus" autocomplete="one-time-code"/>
                        <p class="o_wa_hint"><i class="oi" data-icon="schedule"/> The code expires in 5 minutes.</p>

                        <button type="submit" class="btn o_wa_btn o_wa_btn_dark o_no_wait_lazy_js mt-3">
                            <i class="oi" data-icon="lock_open"/>
                            <span>Verify &amp; sign in</span>
                        </button>
                    </form>

                    <div class="o_wa_otp_actions">
                        <form action="/web/login/whatsapp" method="post" class="o_no_wait_lazy_js">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="action" value="resend_otp"/>
                            <input type="hidden" name="redirect" t-att-value="redirect"/>
                            <button type="submit" class="btn btn-link o_wa_link o_no_wait_lazy_js" t-att-data-wait="resend_wait or None">
                                <i class="oi" data-icon="refresh"/>
                                <span class="o_wa_resend_label">Resend code</span>
                            </button>
                        </form>
                        <a t-att-href="change_number_url" class="o_wa_link">
                            <i class="oi" data-icon="edit"/> Change number
                        </a>
                    </div>
                    <script t-if="resend_wait">
                        (function () {
                            var btn = document.querySelector("[data-wait]");
                            if (!btn) { return; }
                            var label = btn.querySelector(".o_wa_resend_label");
                            var left = parseInt(btn.getAttribute("data-wait"), 10) || 0;
                            btn.disabled = true;
                            var tick = function () {
                                if (left &lt;= 0) { btn.disabled = false; label.textContent = "Resend code"; return; }
                                label.textContent = "Resend code in " + left + "s";
                                left -= 1;
                                setTimeout(tick, 1000);
                            };
                            tick();
                        })();
                    </script>
                </t>

                <div class="o_wa_footer">
                    <a t-att-href="email_login_url" class="o_wa_link">
                        <i class="oi" data-icon="mail"/> Sign in with email &amp; password instead
                    </a>
                    <p>Need help? WhatsApp us on <strong t-out="support_whatsapp"/></p>
                </div>
            </div>
        </t>
    </template>

    <!-- 3. Portal Home Card: Store Purchases handled via portal.entry in Odoo 20 -->

    <!-- 4. My POS Orders List -->
    <template id="portal_my_pos_orders" name="My Store Purchases">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">
            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True" title.translate="Store Purchases"/>

            <div class="o_stephans_portal_title">
                <img src="/whatsapp_connector/static/src/img/store-bag.webp" alt="" class="o_stephans_portal_title_icon"/>
                <div>
                    <h4>Store Purchases</h4>
                    <p>Receipts from your visits to our Masaki and Mikocheni stores.</p>
                </div>
            </div>

            <t t-if="not pos_orders">
                <div class="o_stephans_portal_empty">
                    <img src="/whatsapp_connector/static/src/img/store-bag.webp" alt=""/>
                    <div>
                        <h5>No store receipts yet</h5>
                        <p>Purchases made in store with your phone number will appear here automatically.</p>
                    </div>
                    <a href="/shop" class="btn btn-primary rounded-pill px-4">Shop online</a>
                </div>
            </t>

            <t t-if="pos_orders">
                <div class="table-responsive">
                    <table class="table table-hover o_portal_my_doc_table">
                        <thead>
                            <tr>
                                <th>Receipt Reference</th>
                                <th>Date</th>
                                <th>Store</th>
                                <th>Status</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="pos_orders" t-as="order">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/pos_orders/#{order.id}">
                                            <t t-out="order.pos_reference or order.name"/>
                                        </a>
                                    </td>
                                    <td>
                                        <span t-field="order.date_order" t-options='{"format": "dd MMM yyyy HH:mm"}'/>
                                    </td>
                                    <td>
                                        <t t-out="order.config_id.name or ''"/>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill text-bg-success">Paid</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="order.amount_total" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div t-if="pager" class="o_portal_pager text-center">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- 5. Single POS Order Detail -->
    <template id="portal_pos_order_detail" name="Store Purchase Receipt">
        <t t-call="portal.portal_layout">
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 d-flex align-items-center gap-2">
                        <img src="/whatsapp_connector/static/src/img/store-bag.webp" alt="" class="o_stephans_portal_inline_icon"/>
                        <t t-out="pos_order.pos_reference or pos_order.name"/>
                    </h4>
                    <span class="badge rounded-pill text-bg-success fs-6">Paid</span>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <strong>Date:</strong>
                            <span t-field="pos_order.date_order" t-options='{"format": "dd MMM yyyy HH:mm"}'/>
                        </div>
                        <div class="col-md-6" t-if="pos_order.config_id">
                            <strong>Store:</strong>
                            <t t-out="pos_order.config_id.name"/>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="pos_order.lines" t-as="line">
                                    <tr>
                                        <td><t t-out="line.full_product_name or line.product_id.display_name"/></td>
                                        <td class="text-end"><t t-out="line.qty"/></td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": pos_order.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal_incl" t-options='{"widget": "monetary", "display_currency": pos_order.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Total</th>
                                    <th class="text-end fs-5">
                                        <span t-field="pos_order.amount_total" t-options='{"widget": "monetary", "display_currency": pos_order.currency_id}'/>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="/my/pos_orders" class="btn btn-secondary">
                        <i class="oi" data-icon="arrow_back"/> Back to Store Purchases
                    </a>
                </div>
            </div>
        </t>
    </template>
</odoo>
