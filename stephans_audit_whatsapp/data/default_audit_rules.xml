<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 1. POS Refund & Void Alert -->
    <record id="default_rule_pos_refund" model="audit.whatsapp.rule">
        <field name="name">POS Refund / Negative Bill Alert</field>
        <field name="code">pos_refund</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="action_type">create</field>
        <field name="severity">high</field>
        <field name="send_whatsapp">True</field>
        <field name="recipient_phones">+255769324445</field>
        <field name="alert_template">🚨 *AUDIT ALERT: POS Refund Detected*
━━━━━━━━━━━━━━━━━━━━
• *Model:* {model}
• *Record:* {record}
• *Action:* {action}
• *Cashier:* {user}
• *Time:* {time}
• *Severity:* {severity}
━━━━━━━━━━━━━━━━━━━━
📝 *Details:*
{details}</field>
    </record>

    <!-- 2. POS High Discount Alert (>15%) -->
    <record id="default_rule_pos_discount" model="audit.whatsapp.rule">
        <field name="name">POS High Discount Alert (>15%)</field>
        <field name="code">pos_discount</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="action_type">create</field>
        <field name="severity">medium</field>
        <field name="send_whatsapp">True</field>
        <field name="recipient_phones">+255769324445</field>
        <field name="alert_template">⚠️ *AUDIT ALERT: High Discount Applied*
━━━━━━━━━━━━━━━━━━━━
• *Model:* {model}
• *Record:* {record}
• *Action:* {action}
• *Cashier:* {user}
• *Time:* {time}
━━━━━━━━━━━━━━━━━━━━
📝 *Discount Breakdown:*
{details}</field>
    </record>

