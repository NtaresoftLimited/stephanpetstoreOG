<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RULE FORM VIEW -->
    <record id="view_audit_whatsapp_rule_form" model="ir.ui.view">
        <field name="name">audit.whatsapp.rule.form</field>
        <field name="model">audit.whatsapp.rule</field>
        <field name="arch" type="xml">
            <form string="Audit WhatsApp Rule">
                <header>
                    <button name="action_send_test_alert" string="Send Test WhatsApp Alert" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Audit Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Rule Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. POS Refund &amp; Void Alert"/>
                        </h1>
                    </div>
                    <group>
                        <group name="rule_trigger" string="Trigger Configuration">
                            <field name="code"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="action_type"/>
                            <field name="severity"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group name="rule_dispatch" string="Notification Delivery">
                            <field name="send_whatsapp" widget="boolean_toggle"/>
                            <field name="recipient_phones" placeholder="+255769324445, 0712345678"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="WhatsApp Template" name="template">
                            <group>
                                <field name="alert_template" placeholder="Message content..." nolabel="1"/>
                            </group>
                            <div class="text-muted mt-2">
                                <strong>Placeholders:</strong>
                                <code>{rule_name}</code>, <code>{model}</code>, <code>{record}</code>, <code>{action}</code>, <code>{user}</code>, <code>{time}</code>, <code>{severity}</code>, <code>{details}</code>
                            </div>
                        </page>
                        <page string="Monitored Specific Fields" name="fields" invisible="action_type != 'write'">
                            <field name="monitored_field_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- RULE LIST VIEW -->
    <record id="view_audit_whatsapp_rule_tree" model="ir.ui.view">
        <field name="name">audit.whatsapp.rule.list</field>
        <field name="model">audit.whatsapp.rule</field>
        <field name="arch" type="xml">
            <list string="Audit WhatsApp Rules">
                <field name="name"/>
                <field name="code"/>
                <field name="model_id"/>
                <field name="action_type"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'" decoration-info="severity == 'low'"/>
                <field name="send_whatsapp" widget="boolean_toggle"/>
                <field name="recipient_phones"/>
                <field name="log_count" string="Logs"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_audit_whatsapp_rule" model="ir.actions.act_window">
        <field name="name">Audit Notification Rules</field>
        <field name="res_model">audit.whatsapp.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp Audit Rule!
            </p>
            <p>
                Configure rules to track critical model changes and instantly alert managers via WhatsApp.
            </p>
        </field>
    </record>
</odoo>
